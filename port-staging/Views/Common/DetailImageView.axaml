<rxui:ReactiveUserControl
    x:Class="Wabbajack.DetailImageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wabbajack"
    xmlns:vm="using:Wabbajack"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rxui="using:Avalonia.ReactiveUI"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="vm:ViewModel"
    x:DataType="vm:ViewModel"
    ClipToBounds="True"
    mc:Ignorable="d">
    <Border x:Name="BorderMask2" CornerRadius="8" BorderThickness="0" Background="White">
        <Grid>
            <Border Name="BorderMask" CornerRadius="8" Background="White" Margin="1"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.OpacityMask>
                    <VisualBrush Visual="{Binding #BorderMask}" />
                </Grid.OpacityMask>
                <Rectangle Grid.RowSpan="4" Fill="{StaticResource ComplementaryPrimary08Brush}" IsVisible="{Binding ElementName=ModlistImage, Path=Source, Converter={StaticResource IsNotNullVisibilityConverter}}"/>
                <Rectangle Grid.RowSpan="4" Fill="Black"/>
                <Viewbox
                        Grid.RowSpan="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="UniformToFill">
                    <Image x:Name="ModlistImage">
                        <Image.OpacityMask>
                            <LinearGradientBrush StartPoint="0.5, 0" EndPoint="0.5, 1">
                                <LinearGradientBrush.GradientStops>
                                    <GradientStop Offset="0.5" Color="Black"/>
                                    <GradientStop Offset="1.0" Color="Transparent"/>
                                </LinearGradientBrush.GradientStops>
                            </LinearGradientBrush>
                        </Image.OpacityMask>
                    </Image>
                </Viewbox>
                <!--
                    <Rectangle
                            Margin="-80, 0, -80, -75"
                            VerticalAlignment="Bottom"
                            Fill="Black"
                            Opacity="0.7">
                        <Rectangle.Effect>
                            <BlurEffect Radius="100" />
                        </Rectangle.Effect>
                    </Rectangle>
                    -->
                <TextBlock Grid.Row="2"
            x:Name="TitleTextBlock"
            Margin="16, 0, 0, 0"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            FontWeight="Bold"
            TextWrapping="WrapWithOverflow">
                </TextBlock>
                <StackPanel Grid.Row="3" Margin="16, 0, 0, 16" Orientation="Horizontal">
                    <StackPanel.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="Margin" Value="0,0,8,0" />
                        </Style>
                    </StackPanel.Styles>
                    <TextBlock x:Name="VersionPrefixText" Text="version" Foreground="{StaticResource Transparent66ForegroundBrush}" />
                    <TextBlock x:Name="VersionText" />
                    <TextBlock x:Name="AuthorPrefixText" Text="by" Foreground="{StaticResource Transparent66ForegroundBrush}" />
                    <TextBlock x:Name="AuthorText" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</rxui:ReactiveUserControl>
