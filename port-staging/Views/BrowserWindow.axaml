<UserControl
    x:Class="Wabbajack.BrowserWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wabbajack"
    xmlns:vm="using:Wabbajack"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:fluent="using:FluentIcons.Avalonia"
    x:DataType="vm:BrowserWindowViewModel"
    mc:Ignorable="d">
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" FontSize="18" Name="Header"></TextBlock>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Name="Instructions"></TextBlock>
        <local:WJButton Grid.Row="2" Grid.Column="0" x:Name="BackButton" ButtonStyle="Transparent" Icon="ChevronLeft" Margin="0, 0, 4, 0" Width="56" HorizontalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0, 8, 0, 8" Foreground="{StaticResource DisabledButtonForeground}" VerticalContentAlignment="Center" Name="AddressBar" IsEnabled="True" IsReadOnly="True"></TextBox>
        <Button
            x:Name="CloseButton"
            Grid.Column="3"
            Style="{StaticResource MainButtonStyle}"
            Background="Transparent"
            BorderThickness="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Padding="0, 4, 0, 8">
            <fluent:SymbolIcon Symbol="Dismiss" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Button>
        <Grid x:Name="WebViewGrid" Grid.Row="3" Grid.ColumnSpan="4" Margin="0, 0, 0, -16">
            <TextBlock
                x:Name="WebViewWarning"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Foreground="{StaticResource ForegroundBrush}">
                <!--
                    TODO: WPF hosts the ic:SymbolIcon UIElement directly as TextBlock content, which WPF's
                    XAML parser implicitly wraps into an InlineUIContainer. Avalonia's TextBlock has no such
                    implicit conversion, so an explicit InlineUIContainer is required here.
                -->
                <InlineUIContainer>
                    <fluent:SymbolIcon Width="13" Height="13" FontSize="13" Symbol="Warning" />
                </InlineUIContainer>
                <Run Text="If you're seeing this, WebView failed to initialize!" />
                <Run Text="Check out" />
                <!--
                    TODO: WPF's Documents.Hyperlink inline (with a bound Command) has no equivalent inline
                    element in Avalonia (no Hyperlink class, no implicit Command-bound inline). Translated
                    to a borderless, underlined inline Button wrapped in an InlineUIContainer, bound to the
                    same OpenWebViewHelpCommand. Verify visual styling matches the original hyperlink look.
                -->
                <InlineUIContainer>
                    <Button
                        Command="{Binding OpenWebViewHelpCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        VerticalAlignment="Center">
                        <TextBlock Text="this section" TextDecorations="Underline" />
                    </Button>
                </InlineUIContainer>
                <Run Text="on the Wabbajack wiki for more information on how to solve this issue." />
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
