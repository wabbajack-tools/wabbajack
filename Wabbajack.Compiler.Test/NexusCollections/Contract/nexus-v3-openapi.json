  "schemas": {
    "CollectionManifest": {
      "properties": {
        "info": {
          "$ref": "#/components/schemas/CollectionManifestInfo"
        },
        "mods": {
          "items": {
            "$ref": "#/components/schemas/CollectionManifestMod"
          },
          "type": "array"
        }
      },
      "required": [
        "info",
        "mods"
      ],
      "type": "object"
    },
    "CollectionManifestInfo": {
      "properties": {
        "author": {
          "type": "string"
        },
        "author_url": {
          "nullable": true,
          "type": "string"
        },
        "description": {
          "nullable": true,
          "type": "string"
        },
        "domain_name": {
          "type": "string"
        },
        "game_versions": {
          "items": {
            "type": "string"
          },
          "nullable": true,
          "type": "array"
        },
        "name": {
          "maxLength": 36,
          "minLength": 3,
          "type": "string"
        },
        "summary": {
          "maxLength": 255,
          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "author",
        "name",
        "domain_name"
      ],
      "type": "object"
    },
    "CollectionManifestMod": {
      "properties": {
        "author": {
          "nullable": true,
          "type": "string"
        },
        "domain_name": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/components/schemas/CollectionManifestModSource"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "optional",
        "domain_name",
        "source"
      ],
      "type": "object"
    },
    "CollectionManifestModSource": {
      "properties": {
        "adult_content": {
          "nullable": true,
          "type": "boolean"
        },
        "file_expression": {
          "nullable": true,
          "type": "string"
        },
        "file_id": {
          "type": "string"
        },
        "file_size": {
          "nullable": true,
          "type": "integer"
        },
        "logical_filename": {
          "nullable": true,
          "type": "string"
        },
        "md5": {
          "nullable": true,
          "type": "string"
        },
        "mod_id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/components/schemas/ModSource"
        },
        "update_policy": {
          "$ref": "#/components/schemas/UpdatePolicy"
        },
        "url": {
          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "CollectionPayload": {
      "properties": {
        "adult_content": {
          "type": "boolean"
        },
        "collection_manifest": {
          "$ref": "#/components/schemas/CollectionManifest"
        },
        "collection_schema_id": {
          "type": "integer"
        }
      },
      "required": [
        "adult_content",
        "collection_manifest",
        "collection_schema_id"
      ],
      "type": "object"
    },
    "CreateCollectionRequest": {
      "properties": {
        "collection_data": {
          "$ref": "#/components/schemas/CollectionPayload"
        },
        "upload_id": {
          "format": "uuid",
          "nullable": false,
          "type": "string"
        }
      },
      "required": [
        "upload_id",
        "collection_data"
      ],
      "type": "object"
    },
    "CreateCollectionRevisionRequest": {
      "properties": {
        "collection_data": {
          "$ref": "#/components/schemas/CollectionPayload"
        },
        "upload_id": {
          "format": "uuid",
          "nullable": false,
          "type": "string"
        }
      },
      "required": [
        "upload_id",
        "collection_data"
      ],
      "type": "object"
    },
    "CreateCollectionRevisionSuccess": {
      "properties": {
        "collection_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "revision_number": {
          "type": "integer"
        },
        "revision_status": {
          "$ref": "#/components/schemas/RevisionStatus"
        }
      },
      "required": [
        "id",
        "collection_id",
        "revision_number",
        "revision_status"
      ],
      "type": "object"
    },
    "CreateCollectionSuccess": {
      "properties": {
        "id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "revision_number": {
          "type": "integer"
        },
        "revision_status": {
          "$ref": "#/components/schemas/RevisionStatus"
        },
        "slug": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "revision_id",
        "revision_number",
        "revision_status"
      ],
      "type": "object"
    },
    "CreateMultipartUploadSuccess": {
      "allOf": [
        {
          "$ref": "#/components/schemas/Upload"
        }
      ],
      "properties": {
        "complete_presigned_url": {
          "type": "string"
        },
        "part_presigned_urls": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "part_size_bytes": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "part_size_bytes",
        "part_presigned_urls",
        "complete_presigned_url"
      ],
      "type": "object"
    },
    "CreateUploadRequest": {
      "properties": {
        "crc64nvme": {
          "nullable": true,
          "pattern": "^[A-Za-z0-9+/]{11}=$",
          "type": "string"
        },
        "filename": {
          "nullable": false,
          "type": "string"
        },
        "size_bytes": {
          "format": "int64",
          "nullable": false,
          "type": "integer"
        }
      },
      "required": [
        "size_bytes",
        "filename"
      ],
      "type": "object"
    },
    "FinaliseUploadSuccess": {
      "allOf": [
        {
          "$ref": "#/components/schemas/Upload"
        }
      ]
    },
    "GetUploadSuccess": {
      "allOf": [
        {
          "$ref": "#/components/schemas/Upload"
        }
      ]
    },
    "ModSource": {
      "enum": [
        "nexus",
        "direct",
        "browse",
        "manual",
        "bundle"
      ],
      "type": "string"
    },
    "ProblemDetails": {
      "properties": {
        "detail": {
          "type": "string"
        },
        "instance": {
          "format": "uri",
          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "detail",
        "instance"
      ],
      "type": "object"
    },
    "RevisionStatus": {
      "enum": [
        "draft",
        "published",
        "retracted"
      ],
      "type": "string"
    },
    "UpdatePolicy": {
      "enum": [
        "exact",
        "latest",
        "prefer"
      ],
      "type": "string"
    },
    "Upload": {
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "state": {
          "$ref": "#/components/schemas/UploadState"
        },
        "user": {
          "$ref": "#/components/schemas/UploadUser"
        }
      },
      "required": [
        "id",
        "user",
        "state"
      ],
      "type": "object"
    },
    "UploadState": {
      "enum": [
        "created",
        "available"
      ],
      "type": "string"
    },
    "UploadUser": {
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "ValidationProblem": {
      "allOf": [
        {
          "$ref": "#/components/schemas/ProblemDetails"
        },
        {
          "properties": {
            "errors": {
              "items": {
                "$ref": "#/components/schemas/ValidationProblemItem"
              },
              "type": "array"
            }
          },
          "required": [
            "errors"
          ],
          "type": "object"
        }
      ]
    },
    "ValidationProblemItem": {
      "properties": {
        "detail": {
          "type": "string"
        },
        "pointer": {
          "type": "string"
        }
      },
      "required": [
        "detail",
        "pointer"
      ],
      "type": "object"
    }
  },
  "server": "https://api.nexusmods.com/v3",
  "source": "https://api.nexusmods.com/openapi.yaml",
  "version": "3.0.0"
}
