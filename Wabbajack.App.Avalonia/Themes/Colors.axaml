  <SolidColorBrush x:Key="InactiveSelectionHighlightBrush" Color="#335C85" />
  <SolidColorBrush x:Key="ComboBoxButtonNormalBackground" Color="Transparent" />
  <SolidColorBrush x:Key="ButtonNormalBackground" Color="{StaticResource ComplementaryPrimary08}" />
  <SolidColorBrush x:Key="ButtonNormalBorder" Color="{StaticResource ComplementaryPrimary08}" />
  <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource ForegroundColor}" />
  <SolidColorBrush x:Key="MouseOverButtonForeground" Color="White" />
  <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="ButtonBorder" Color="{StaticResource ComplementaryPrimary08}" />
  <SolidColorBrush x:Key="PressedButtonBackground" Color="{StaticResource PressedBackgroundColor}" />
  <SolidColorBrush x:Key="PressedButtonForeground" Color="{StaticResource Primary}" />
  <SolidColorBrush x:Key="MouseOverButtonBackground" Color="{StaticResource LightBackgroundColor}" />
  <SolidColorBrush x:Key="DisabledButtonBackground" Color="{StaticResource ComplementaryPrimary16}" />
  <SolidColorBrush x:Key="DisabledButtonForeground" Color="{StaticResource DisabledForegroundColor}" />
  <SolidColorBrush x:Key="MouseOverDangerButtonBackground" Color="{StaticResource RedDark}" />
  <SolidColorBrush x:Key="MouseOverDangerButtonForeground" Color="#ebe5e5" />
  <SolidColorBrush x:Key="ToggleButtonBackground" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="ToggleButtonForeground" Color="{StaticResource ForegroundColor}" />
