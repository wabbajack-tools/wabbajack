  <SolidColorBrush x:Key="PressedToggleButtonForeground" Color="{StaticResource ForegroundColor}" />
  <SolidColorBrush x:Key="DisabledToggleButtonBackground" Color="{StaticResource ComplementaryPrimary08}" />
  <SolidColorBrush x:Key="DisabledToggleButtonForeground" Color="{StaticResource DisabledForegroundColor}" />
  <SolidColorBrush x:Key="Expander.Background" Color="{StaticResource LightBackgroundColor}" />
  <SolidColorBrush x:Key="Expander.MouseOver.Arrow.Stroke" Color="{StaticResource Primary}" />
  <SolidColorBrush x:Key="Expander.Disabled.Arrow.Stroke" Color="{StaticResource DarkSecondary}" />
  <SolidColorBrush x:Key="Expander.Static.Arrow.Stroke" Color="{StaticResource Primary}" />
  <SolidColorBrush x:Key="CheckBoxFillNormal" Color="{StaticResource ComplementaryPrimary08}" />
  <SolidColorBrush x:Key="CheckBoxForeground" Color="{StaticResource Primary}" />
  <SolidColorBrush x:Key="CheckBoxMouseOverStroke" Color="{StaticResource ForegroundColor}" />
  <SolidColorBrush x:Key="CheckBoxDisabledStroke" Color="{StaticResource DisabledBackgroundColor}" />
  <SolidColorBrush x:Key="CheckBoxDisabledForeground" Color="#939393" />
  <SolidColorBrush x:Key="CheckBoxStroke" Color="{StaticResource ComplementaryPrimary08}" />
  <SolidColorBrush x:Key="RadioButtonMouseOverStroke" Color="{StaticResource ForegroundColor}" />
  <SolidColorBrush x:Key="RadioButtonDisabledStroke" Color="{StaticResource DisabledBackgroundColor}" />
  <SolidColorBrush x:Key="RadioButtonDisabledForeground" Color="#939393" />
  <SolidColorBrush x:Key="RadioButtonStroke" Color="{StaticResource DarkBackgroundColor}" />
  <SolidColorBrush x:Key="RadioButtonForeground" Color="{StaticResource ForegroundColor}" />
  <!-- The WPF source pointed this at a LightDisabledBackgroundColor that it never defined; the brush
       was never requested, so WPF's lazy dictionary never surfaced it. Resolved to the disabled
       colour it was clearly meant to be rather than left as a key that throws on first use. -->
  <SolidColorBrush x:Key="RadioButtonBackground" Color="{StaticResource DisabledBackgroundColor}" />
  <SolidColorBrush x:Key="ListBorder" Color="{StaticResource DarkBackgroundColor}" />
  <SolidColorBrush x:Key="ListBackground" Color="{StaticResource ComplementaryPrimary08}" />
  <SolidColorBrush x:Key="SelectedListItem" Color="{StaticResource ComplementaryPrimary16}" />
  <SolidColorBrush x:Key="SelectedListItemForeground" Color="{StaticResource Primary}" />
  <SolidColorBrush x:Key="MouseOverListItem" Color="{StaticResource ComplementaryPrimary16}" />
  <SolidColorBrush x:Key="TreeViewBackground" Color="{StaticResource ComplementaryPrimary08}" />
  <SolidColorBrush x:Key="TreeViewDisabledForeground" Color="{StaticResource DisabledForegroundColor}" />
  <SolidColorBrush x:Key="DisabledMenuForeground" Color="#656565" />
  <SolidColorBrush x:Key="MenuBackground" Color="#3A3A3A" />
  <SolidColorBrush x:Key="MenuItemSelectionFill" Color="{StaticResource HighlightColor}" />
  <SolidColorBrush x:Key="SubMenuBackgroundBrush" Color="#3A3A3A" />
  <SolidColorBrush x:Key="MenuItemPressedFill" Color="{StaticResource HighlightColor}" />
  <SolidColorBrush x:Key="SubMenuBorderBrush" Color="{StaticResource LightBackgroundColor}" />
  <SolidColorBrush x:Key="SubMenuRepeatButtonBrush" Color="{StaticResource HotColor}" />
  <SolidColorBrush x:Key="SubMenuHoverRepeatButtonBrush" Color="#7F7F7F" />
  <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#4C4C4C" />
  <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="{StaticResource ComplementaryPrimary08}" />
  <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="{StaticResource ComplementaryPrimary08}" />
  <SolidColorBrush x:Key="DataGridHeaderMouseOverBrush" Color="{StaticResource Primary}" />
  <SolidColorBrush x:Key="DataGridHeaderBorderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="DataGridRowBorderBrush" Color="{StaticResource DisabledBackgroundColor}" />
  <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="{StaticResource ComplementaryPrimary08}" />
  <SolidColorBrush x:Key="DataGridRowSelectedBrush" Color="{StaticResource HighlightColor}" />
  <SolidColorBrush x:Key="GridLinesBrush" Color="Transparent" />
  <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.Background" Color="{StaticResource ComplementaryPrimary08}"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.Border" Color="Transparent"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.Disabled.Background" Color="{StaticResource ComplementaryPrimary08}"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.Disabled.Border" Color="Transparent"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.Disabled.Foreground" Color="{StaticResource ForegroundColor}"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.MouseOver.Background" Color="{StaticResource DarkHoverBackgroundColor}"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.MouseOver.Border" Color="Transparent"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.Pressed.Background" Color="{StaticResource ComplementaryPrimary16}"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.Button.Pressed.Border" Color="Transparent"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.ListBox.GroupHeader.Background" Color="{StaticResource ComplementaryPrimary08}"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.ListBox.GroupHeader.Foreground" Color="{StaticResource ForegroundColor}"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.ListBoxItem.SelectedOrder.Foreground" Color="{StaticResource Primary}"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.ListBoxItem.Selector.Background" Color="{StaticResource ComplementaryPrimary16}"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.ListBoxItem.Selector.Border" Color="Transparent"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.ListBoxItem.Selected.Background" Color="{StaticResource ComplementaryPrimary16}" />
  <SolidColorBrush x:Key="MultiSelectComboBox.DropDown.ListBoxItem.Selected.Border" Color="Transparent"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.SelectedItem.Border" Color="Transparent"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.SelectedItem.Button.Foreground" Color="{StaticResource ForegroundColor}"/>
