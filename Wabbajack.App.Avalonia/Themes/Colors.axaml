  <SolidColorBrush x:Key="MouseOverToggleButtonBackground" Color="{StaticResource ComplementaryPrimary08}" />
  <SolidColorBrush x:Key="MouseOverToggleButtonForeground" Color="{StaticResource ForegroundColor}" />
