  <Color x:Key="Primary">#D8BAF8</Color>
  <Color x:Key="BackgroundPrimary08">#303141</Color>
  <Color x:Key="ComplementaryPrimary08">#383750</Color>
  <Color x:Key="ComplementaryPrimary12">#3f3c57</Color>
  <Color x:Key="ComplementaryPrimary16">#46425F</Color>
  <Color x:Key="ComplementaryPrimary32">#62597C</Color>
  <Color x:Key="ComplementaryPrimary50">#81739d</Color>
  <Color x:Key="ComplementaryWhite02">#2d2e45</Color>
  <Color x:Key="ComplementaryWhite25">#5f6071</Color>
  <Color x:Key="ComplementaryBGBackground08">#313146</Color>
  <Color x:Key="PrimaryVariant">#8866ad</Color>
  <Color x:Key="DarkPrimaryAlt">#514c6b</Color>
  <Color x:Key="DarkPrimaryVariant">#270080</Color>
  <Color x:Key="DarkerPrimaryVariant">#1b0059</Color>
  <Color x:Key="Secondary">#3C3652</Color>
  <Color x:Key="DarkSecondary">#363952</Color>
  <Color x:Key="DarkerSecondary">#095952</Color>
  <Color x:Key="SecondaryBackground">#042421</Color>
  <Color x:Key="OffWhiteSeconday">#cef0ed</Color>
  <Color x:Key="LightSecondary">#8cede5</Color>
  <Color x:Key="IntenseSecondary">#00ffe7</Color>
  <Color x:Key="Complementary">#4e4571</Color>
  <Color x:Key="DarkComplementary">#3C3652</Color>
  <Color x:Key="ComplementaryBackground">#2A2B41</Color>
  <Color x:Key="IntenseComplementary">#abf74d</Color>
  <Color x:Key="Analogous1">#868CFC</Color>
  <Color x:Key="Analogous2">#F686FC</Color>
  <Color x:Key="Triadic1">#FC86C7</Color>
  <Color x:Key="Triadic2">#FCBB86</Color>
  <Color x:Key="MahApps.Colors.AccentBase">#FF222531</Color>
  <Color x:Key="MahApps.Colors.Accent">#CCD8BAF8</Color>
  <Color x:Key="MahApps.Colors.Accent2">#99D8BAF8</Color>
  <Color x:Key="MahApps.Colors.Accent3">#66D8BAF8</Color>
  <Color x:Key="MahApps.Colors.Accent4">#33D8BAF8</Color>

  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Green}" />
  <SolidColorBrush x:Key="MaintenanceBrush" Color="{StaticResource Yellow}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Yellow}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource RedDark}" />
  <SolidColorBrush x:Key="NSFWBrush" Color="{StaticResource NSFW}" />
  <SolidColorBrush x:Key="UnavailableBrush" Color="{StaticResource Unavailable}" />
  <SolidColorBrush x:Key="UnavailableDarkBrush" Color="{StaticResource UnavailableDark}" />
  <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackgroundColor}" />
  <SolidColorBrush x:Key="DarkHoverBackgroundBrush" Color="{StaticResource DarkHoverBackgroundColor}" />
