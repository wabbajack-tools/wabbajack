  <SolidColorBrush x:Key="MultiSelectComboBox.SelectedItem.Button.Light.Foreground" Color="{StaticResource ForegroundColor}"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.SelectedItemsPanel.Border" Color="Transparent"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.Text.Disabled.Foreground" Color="{StaticResource DisabledForegroundColor}"/>
  <SolidColorBrush x:Key="MultiSelectComboBox.Text.Foreground" Color="{StaticResource ForegroundColor}"/>
  <SolidColorBrush x:Key="LogViewAlternateBrush" Color="{StaticResource Primary}" Opacity="0.03" />
  <SolidColorBrush x:Key="ProgressBrush" Color="{StaticResource Primary}" Opacity="0.16" />
  <SolidColorBrush x:Key="Transparent04PrimaryBrush" Color="{StaticResource Primary}" Opacity="0.04" />
