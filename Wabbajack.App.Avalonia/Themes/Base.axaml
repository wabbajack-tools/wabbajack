<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    App-wide defaults. The WPF theme applied these through implicit (TargetType-keyed) styles;
    Avalonia needs explicit type selectors. Together with RequestedThemeVariant="Dark" on the
    Application this replaces the Fluent light defaults (white surfaces / black text) with the
    Wabbajack palette, and restores the Gabarito font and the control padding the WPF theme had.
  -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
  </Style>

  <Style Selector="UserControl">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource DarkBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <!-- Buttons that carry no explicit Wabbajack class still need sane dark styling + padding.
       HorizontalAlignment/VerticalAlignment are restated because Avalonia's Fluent theme pins buttons
       to Left/Center, whereas WPF's default was Stretch - without this every button in a layout cell
       shrinks to its content instead of filling the cell the way the original views assumed. Views
       that want a content-sized button set the alignment locally, which still wins over this. -->
  <Style Selector="Button">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
    <Setter Property="Background" Value="{DynamicResource ComplementaryPrimary08Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MouseOverButtonBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderInterestBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressedButtonBackground}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DisabledButtonBackground}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource DisabledButtonForeground}" />
  </Style>

  <Style Selector="ToggleButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
    <Setter Property="Background" Value="{DynamicResource ComplementaryPrimary08Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <!-- Fluent paints the checked state with the system accent (blue); use the Wabbajack primary. -->
  <Style Selector="ToggleButton:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource BackgroundBrush}" />
  </Style>
  <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryVariantBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryVariantBrush}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Padding" Value="8,0,0,0" />
  </Style>
  <!-- Same accent leak on checkbox glyph backgrounds. -->
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
  </Style>
  <Style Selector="RadioButton:checked /template/ Ellipse#CheckOuterEllipse">
    <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
  </Style>
  <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource DarkBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- DataGrid (modlist details archive list). The packaged Fluent DataGrid theme still paints
       light headers/rows under our palette, so restate the surfaces explicitly. -->
  <Style Selector="DataGrid">
    <!-- Opaque, not Transparent: the details view paints a white Border behind the grid as the
         source for its rounded-corner OpacityMask, which otherwise shows through the gap between
         column headers as a white bar. -->
    <Setter Property="Background" Value="{DynamicResource ComplementaryBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ComplementaryPrimary08Brush}" />
    <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
    <Setter Property="RowBackground" Value="Transparent" />
  </Style>

  <Style Selector="DataGridColumnHeader">
    <Setter Property="AreSeparatorsVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource DarkBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="SeparatorBrush" Value="{DynamicResource DarkBackgroundBrush}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <!-- The column-resize grippers are Thumbs; Fluent's default Thumb theme paints them solid white
       over the header. Make them invisible but still draggable. -->
  <Style Selector="DataGridColumnHeader /template/ Thumb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource ComplementaryPrimary08Brush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource ComplementaryPrimary16Brush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="DataGridCell">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
</Styles>
