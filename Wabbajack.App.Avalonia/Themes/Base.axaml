<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    App-wide defaults. The WPF theme applied these through implicit (TargetType-keyed) styles;
    Avalonia needs explicit type selectors. Together with RequestedThemeVariant="Dark" on the
    Application this replaces the Fluent light defaults (white surfaces / black text) with the
    Wabbajack palette, and restores the Gabarito font and the control padding the WPF theme had.
  -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
  </Style>

  <Style Selector="UserControl">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource DarkBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <!-- Fluent swaps the border element's background to a near-black "focused" colour and paints a
       light focus border, so clicking into any field turned it black with a white outline while
       every other field stayed on the Wabbajack palette. Bind straight back to the control's own
       Background so class-specific backgrounds (e.g. TextBox.Value) keep working. -->
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderInterestBrush}" />
  </Style>

  <!-- Buttons that carry no explicit Wabbajack class still need sane dark styling + padding.
       HorizontalAlignment/VerticalAlignment are restated because Avalonia's Fluent theme pins buttons
       to Left/Center, whereas WPF's default was Stretch - without this every button in a layout cell
       shrinks to its content instead of filling the cell the way the original views assumed. Views
       that want a content-sized button set the alignment locally, which still wins over this. -->
  <Style Selector="Button">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
    <Setter Property="Background" Value="{DynamicResource ComplementaryPrimary08Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MouseOverButtonBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderInterestBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressedButtonBackground}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DisabledButtonBackground}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource DisabledButtonForeground}" />
  </Style>

  <Style Selector="ToggleButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
    <Setter Property="Background" Value="{DynamicResource ComplementaryPrimary08Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <!-- Fluent paints the checked state with the system accent (blue); use the Wabbajack primary. -->
  <Style Selector="ToggleButton:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource BackgroundBrush}" />
  </Style>
  <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryVariantBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryVariantBrush}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Padding" Value="8,0,0,0" />
  </Style>
  <!-- Same accent leak on checkbox glyph backgrounds. -->
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
  </Style>
  <Style Selector="RadioButton:checked /template/ Ellipse#CheckOuterEllipse">
    <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
  </Style>
  <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
  </Style>

  <!--
    Every ProgressBar in the app was drawing in Fluent's system accent (a bright blue that appears
    nowhere else in Wabbajack) over a grey track. The seven indeterminate ones stand in for MahApps
    ProgressRings and declare a small square size, but Fluent's theme sets MinWidth=200, so instead
    of a 32px spinner they rendered as a 200px blue slab - most visibly straight across the middle of
    the modlist banner on the install screen. Views that need other colours (the CPU rows, the top
    progress bar's gradients) set them locally, which still wins over this.
  -->
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource ComplementaryPrimary08Brush}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!--
    Scrollbars. Themes/Colors.axaml carries the full set of WPF scrollbar brushes, but WPF applied
    them through its own ScrollBar/ScrollBarThumb template rewrites - neither of which was ported, so
    Fluent's theme kept using its own keys and every scrollbar in the app drew in stock grey while
    these six palette entries sat unused. WPF's thumb: ComplementaryPrimary16 at rest, widening from
    8px to 16px and shifting to ComplementaryPrimary50 on hover, then to the lilac Primary while
    dragging.
  -->
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource VerticalScrollBarThumb}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ScrollBar:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource ScrollBarMouseOverThumb}" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource ScrollBarSelectedThumb}" />
  </Style>

  <!--
    WPF styled ToolTip implicitly (Themes/Styles.xaml): a rounded card in the complementary surface
    colour with a lilac border. That style was never ported, so all 38 ToolTip.Tip usages in the app
    were rendering as Fluent's default neutral-grey box - the only chrome in the whole UI still using
    stock colours. Avalonia's own theme already wraps the text, so only the surface needs restating.
  -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource ComplementaryPrimary08Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MaxWidth" Value="500" />
  </Style>

  <!-- Also implicit in WPF and not ported. Label's Padding of 5 matters: the gallery's "Include"
       heading is a Label and sat flush against the panel edge without it. -->
  <Style Selector="Label">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="ItemsControl">
    <Setter Property="Focusable" Value="False" />
  </Style>

  <Style Selector="ComboBox">
    <!-- Same Fluent-vs-WPF default as Button above: Avalonia pins the ComboBox to the left and sizes
         it to its content, so the gallery's game filter and the compiler's profile picker sat
         noticeably narrower than the fields stacked above and below them. -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource DarkBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Opaque, for the same reason as DataGrid below: the views hosting these paint a white Border
       as the source for their rounded-corner OpacityMask, and a transparent list surface lets that
       white through as a slab (LogView, CompilerFileManagerView). -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource ComplementaryBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <!-- Fluent paints selection with the system accent (blue); use the Wabbajack palette. Without
       this the highlighted row in the compiler's log viewer came out bright blue. -->
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedListItem}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MouseOverListItem}" />
  </Style>

  <!-- And again for the dropdown rows, e.g. the gallery's game filter. -->
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedListItem}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MouseOverListItem}" />
  </Style>

  <Style Selector="TreeView">
    <Setter Property="Background" Value="{DynamicResource ComplementaryBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="TreeViewItem">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>
  <!-- Same system-accent leak as ListBox/ToggleButton: without these, selecting a row in the
       compiler's file tree painted it bright Fluent blue. -->
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SelectedListItem}" />
  </Style>
  <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource MouseOverListItem}" />
  </Style>
  <!-- TODO: WPF drew the tree's expand/collapse arrow in Primary (TreeViewToggleButtonStyle, via
       Expander.Static.Arrow.Stroke); ours is still Fluent's grey chevron, so the three
       Expander.*.Arrow.Stroke brushes in Colors.axaml remain unused. Tried and measured as having no
       effect: Foreground on TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron, the same
       selector unscoped, and /template/ Path and /template/ PathIcon beneath it. The glyph appears
       not to take its colour from any of those, so tinting it likely needs a full ControlTheme for
       the chevron ToggleButton rather than a setter. -->

  <!-- DataGrid (modlist details archive list). The packaged Fluent DataGrid theme still paints
       light headers/rows under our palette, so restate the surfaces explicitly. -->
  <Style Selector="DataGrid">
    <!-- Opaque, not Transparent: the details view paints a white Border behind the grid as the
         source for its rounded-corner OpacityMask, which otherwise shows through the gap between
         column headers as a white bar. -->
    <Setter Property="Background" Value="{DynamicResource ComplementaryBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ComplementaryPrimary08Brush}" />
    <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
    <Setter Property="RowBackground" Value="Transparent" />
  </Style>

  <Style Selector="DataGridColumnHeader">
    <Setter Property="AreSeparatorsVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource DarkBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="SeparatorBrush" Value="{DynamicResource DarkBackgroundBrush}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <!-- The column-resize grippers are Thumbs; Fluent's default Thumb theme paints them solid white
       over the header. Make them invisible but still draggable. -->
  <Style Selector="DataGridColumnHeader /template/ Thumb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource ComplementaryPrimary08Brush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource ComplementaryPrimary16Brush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="DataGridCell">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
</Styles>
