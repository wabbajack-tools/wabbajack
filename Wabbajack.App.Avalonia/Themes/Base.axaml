<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    App-wide defaults. The WPF theme applied these through implicit (TargetType-keyed) styles;
    Avalonia needs explicit type selectors. Together with RequestedThemeVariant="Dark" on the
    Application this replaces the Fluent light defaults (white surfaces / black text) with the
    Wabbajack palette, and restores the Gabarito font and the control padding the WPF theme had.
  -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
  </Style>

  <Style Selector="UserControl">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource DarkBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <!-- Buttons that carry no explicit Wabbajack class still need sane dark styling + padding. -->
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
    <Setter Property="Background" Value="{DynamicResource ComplementaryPrimary08Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MouseOverButtonBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderInterestBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressedButtonBackground}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DisabledButtonBackground}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource DisabledButtonForeground}" />
  </Style>

  <Style Selector="ToggleButton">
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
    <Setter Property="Background" Value="{DynamicResource ComplementaryPrimary08Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Padding" Value="8,0,0,0" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource DarkBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- DataGrid (modlist details archive list). The packaged Fluent DataGrid theme still paints
       light headers/rows under our palette, so restate the surfaces explicitly. -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ComplementaryPrimary08Brush}" />
    <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
    <Setter Property="RowBackground" Value="Transparent" />
  </Style>

  <Style Selector="DataGridColumnHeader">
    <Setter Property="AreSeparatorsVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource DarkBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="SeparatorBrush" Value="{DynamicResource DarkBackgroundBrush}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <!-- The packaged theme draws the header separator as a light rectangle regardless of
       SeparatorBrush, so restyle it directly. -->
  <Style Selector="DataGridColumnHeader /template/ Rectangle#VerticalSeparator">
    <Setter Property="Fill" Value="{DynamicResource DarkBackgroundBrush}" />
  </Style>

  <Style Selector="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource ComplementaryPrimary08Brush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource ComplementaryPrimary16Brush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="DataGridCell">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
</Styles>
