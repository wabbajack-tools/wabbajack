<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fluent="using:FluentIcons.Avalonia"
                    xmlns:local="using:Wabbajack">
  <!--
    Templates for the controls that replaced WPF-only third-party widgets:
    MahApps RangeSlider and the SDL Toolkit MultiSelectComboBox. Without these the controls
    are template-less and render as blank space in the gallery filter panel.
  -->

  <!--
    WJButton variants. WJButton.axaml.cs resolves these five keys by name at runtime to fill its
    Theme property (WPF set Style the same way), so they must be ControlThemes in the application's
    resources rather than the class selectors used elsewhere in this port - none of them existed,
    which is why every WJButton rendered as bare text and icon with no chrome.

    Only the pseudo-class states touch the ContentPresenter; the normal-state background is left to
    the default template's TemplateBinding so WJButton's progress-gradient Background (set as a local
    value while a download runs) still shows through. That gradient is masked while the pointer is
    over the button, which WPF's local-value-beats-trigger precedence avoided; the deviation lasts
    only as long as the hover.

    WPF tinted each variant's SymbolIcon through a nested Style.Resources entry. Avalonia rejects
    descendant selectors inside a ControlTheme ("may not directly contain a child or descendent
    selector"), and the icon is part of WJButton's content rather than its template, so the icon
    brush is applied from WJButton's code-behind instead.
  -->
  <ControlTheme x:Key="WJButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource ComplementaryPrimary08Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!-- Restated here, not just in Themes/Base.axaml: an explicitly-assigned ControlTheme resolves
         its BasedOn chain ahead of the application-level styles, so the Fluent default's
         HorizontalAlignment=Left would otherwise win and pin every WJButton to the left of its cell
         instead of centring it (these buttons carry a fixed Width=200). -->
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Style Selector="^:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MouseOverButtonBackground}" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PressedButtonBackground}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DisabledButtonBackground}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource DisabledButtonForeground}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="WJColorButtonStyle" TargetType="Button" BasedOn="{StaticResource WJButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}" />
  </ControlTheme>

  <ControlTheme x:Key="WJDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource WJButtonStyle}">
    <Style Selector="^:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource MouseOverDangerButtonBackground}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource MouseOverDangerButtonForeground}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="WJSemiTransparentButtonStyle" TargetType="Button" BasedOn="{StaticResource WJButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource Transparent08PrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Style Selector="^:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Transparent16PrimaryBrush}" />
    </Style>
  </ControlTheme>

  <!-- WPF also switched this variant's icon to IconVariant=Filled on hover; that was a descendant
       selector on the content, which a ControlTheme cannot express. Dropped as cosmetic. -->
  <ControlTheme x:Key="TransparentButtonStyle" TargetType="Button" BasedOn="{StaticResource WJButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </ControlTheme>

  <ControlTheme x:Key="{x:Type local:MultiSelectComboBox}" TargetType="local:MultiSelectComboBox">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <ToggleButton x:Name="PART_Toggle"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="8,6"
                        Background="{DynamicResource DarkBackgroundBrush}"
                        BorderBrush="{DynamicResource ButtonBorder}"
                        BorderThickness="1"
                        CornerRadius="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="PART_Summary"
                         Grid.Column="0"
                         Text="Any"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource ForegroundBrush}" />
              <Path Grid.Column="1"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Width="8" Height="5"
                    Stretch="Fill"
                    Fill="{DynamicResource DimForegroundBrush}"
                    Data="M 0,0 L 10,0 L 5,6 Z" />
            </Grid>
          </ToggleButton>
          <Popup x:Name="PART_Popup"
                 PlacementTarget="{Binding #PART_Toggle}"
                 Placement="BottomEdgeAlignedLeft"
                 IsLightDismissEnabled="True">
            <Border Background="{DynamicResource DarkBackgroundBrush}"
                    BorderBrush="{DynamicResource ButtonBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4"
                    MinWidth="180">
              <ScrollViewer MaxHeight="260">
                <ItemsControl x:Name="PART_Items" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!--
    Full template for DataGrid column headers. The packaged Fluent theme draws a hard-coded
    white vertical separator whose visibility the DataGrid sets programmatically (a local value
    that style setters cannot override), so the header is templated here instead.
  -->
  <ControlTheme x:Key="{x:Type DataGridColumnHeader}" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource DarkBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PrimaryFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{DynamicResource ComplementaryPrimary08Brush}"
                BorderThickness="0,0,0,1">
          <ContentPresenter Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="RangeSliderThumbTheme" TargetType="Thumb">
    <Setter Property="Template">
      <ControlTemplate>
        <Ellipse Fill="{TemplateBinding Background}"
                 Stroke="{DynamicResource BackgroundBrush}"
                 StrokeThickness="2"
                 Width="16" Height="16" />
      </ControlTemplate>
    </Setter>
    <Setter Property="Cursor" Value="Hand" />
  </ControlTheme>

  <ControlTheme x:Key="{x:Type local:RangeSlider}" TargetType="local:RangeSlider">
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Single track with two thumbs and a highlighted selected range. -->
        <Canvas x:Name="PART_Track" Height="20" Background="Transparent" HorizontalAlignment="Stretch">
          <Border Canvas.Top="8" Height="4" CornerRadius="2"
                  Width="{Binding #PART_Track.Bounds.Width}"
                  Background="{DynamicResource ComplementaryPrimary16Brush}" />
          <Border x:Name="PART_RangeBar" Canvas.Top="8" Height="4" CornerRadius="2"
                  Background="{DynamicResource PrimaryBrush}" />
          <Thumb x:Name="PART_LowerThumb" Theme="{StaticResource RangeSliderThumbTheme}" Canvas.Top="2" Width="16" Height="16"
                 Background="{DynamicResource PrimaryBrush}" />
          <Thumb x:Name="PART_UpperThumb" Theme="{StaticResource RangeSliderThumbTheme}" Canvas.Top="2" Width="16" Height="16"
                 Background="{DynamicResource PrimaryBrush}" />
        </Canvas>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
