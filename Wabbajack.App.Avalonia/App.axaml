<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Wabbajack"
             xmlns:conv="using:Wabbajack.Converters"
             x:Class="Wabbajack.App"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="PrimaryFont">avares://WabbajackAvalonia/Assets/Fonts/Gabarito.ttf#Gabarito</FontFamily>
            <!-- Theme Fluent's accent-coloured controls (sliders, checkboxes, progress, selection)
                 to the Wabbajack brand purple instead of the default system blue. -->
            <Color x:Key="SystemAccentColor">#D8BAF8</Color>
            <Color x:Key="SystemAccentColorLight1">#E0C8FA</Color>
            <Color x:Key="SystemAccentColorLight2">#E8D6FB</Color>
            <Color x:Key="SystemAccentColorLight3">#F0E4FD</Color>
            <Color x:Key="SystemAccentColorDark1">#B894E6</Color>
            <Color x:Key="SystemAccentColorDark2">#9A72CC</Color>
            <Color x:Key="SystemAccentColorDark3">#7C50B3</Color>
            <!-- Match the WPF buttons' hover/pressed states (brand #4e4571 bg, light text) instead
                 of Fluent's default grey, by overriding the Fluent Button theme brushes. -->
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4e4571" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4e4571" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E5E5E8" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E5E5E8" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            <conv:IsZeroConverter x:Key="IsZero" />
            <conv:AbsolutePathConverter x:Key="AbsolutePathConverter" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:FileSizeConverter x:Key="FileSize" />
            <conv:BytesToGbConverter x:Key="BytesToGb" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://WabbajackAvalonia/Styles/Brand.axaml" />
                <ResourceInclude Source="avares://WabbajackAvalonia/Styles/LogoBackground.axaml" />
                <ResourceInclude Source="avares://WabbajackAvalonia/Controls/RangeSlider.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
