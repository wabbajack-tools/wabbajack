<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Wabbajack.App.Avalonia.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Wabbajack.Avalonia/Themes/Palette.axaml" />
                <ResourceInclude Source="avares://Wabbajack.Avalonia/Themes/Logos.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="PrimaryFont">avares://Wabbajack.Avalonia/Assets/Fonts#Gabarito</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Wabbajack.Avalonia/Themes/Controls.axaml" />
    </Application.Styles>
</Application>
