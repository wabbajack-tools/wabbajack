<rxui:ReactiveUserControl
    x:Class="Wabbajack.FileUploadView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wabbajack"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rxui="using:Avalonia.ReactiveUI"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:vm="using:Wabbajack"
    x:DataType="vm:FileUploadVM"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="vm:FileUploadVM"
    mc:Ignorable="d">
    <Border
        x:Name="AuthorFiles">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="3"
                FontSize="20"
                FontWeight="Bold"
                Text="Upload file" />

            <Button x:Name="CloseButton" Classes="MainButtonStyle" Background="Transparent"
                    BorderThickness="0" HorizontalAlignment="Right" Padding="16" Margin="-16, -16, -16, 0" VerticalAlignment="Center">
                <ic:SymbolIcon Symbol="Dismiss" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Button>

            <!--
                TODO: WPF's AllowDrop + Drop/DragEnter/DragLeave routed events map to Avalonia's
                DragDrop attached events (Avalonia.Input.DragDrop). AllowDrop/Drop are wired here via
                XAML attached-event syntax (same static wiring the WPF markup used for Drop); the
                DragEnter/DragLeave subscriptions that WPF wired via ReactiveMarbles' .Events() in
                WhenActivated are translated to manual AddHandler/RemoveHandler calls in code-behind
                (Avalonia controls have no CLR DragEnter/DragLeave events for .Events() to bind to).
            -->
            <Rectangle x:Name="UploadBackground"
                       DragDrop.AllowDrop="True"
                       DragDrop.Drop="OnDrop"
                       Grid.Row="2"
                       Fill="{StaticResource ComplementaryPrimary08Brush}"
                       RadiusX="8" RadiusY="8" />

            <Grid x:Name="StartUploadGrid"
                  Grid.Row="2"
                  VerticalAlignment="Center">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ic:SymbolIcon
                    x:Name="StartUploadIcon"
                    Foreground="{StaticResource PrimaryBrush}"
                    Grid.Row="0"
                    FontSize="108"
                    Symbol="ArrowCircleDown" />

                <TextBlock
                    x:Name="DragToUploadText"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    FontSize="36">
                    <!--
                        TODO: WPF's Documents.Hyperlink inline (bound to a Command) has no equivalent
                        inline element in Avalonia. Translated to a borderless, underlined inline
                        Button wrapped in an InlineUIContainer, keeping the same x:Name
                        (ChooseFileHyperlink) so the existing Command binding in code-behind still
                        targets a Command property (Button.Command).
                    -->
                    <InlineUIContainer>
                        <Button x:Name="ChooseFileHyperlink" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center">
                            <TextBlock Text="Choose a file" TextDecorations="Underline" />
                        </Button>
                    </InlineUIContainer>
                    <Run Text=" or drag &amp; drop" />
                </TextBlock>

                <TextBlock
                    x:Name="FairUseText"
                    Grid.Row="4"
                    HorizontalAlignment="Center"
                    FontSize="13">
                    Please only upload files in accordance with the CDN usage policy on the wiki.
                </TextBlock>
            </Grid>

            <Grid x:Name="UploadingGrid"
                  Grid.Row="2"
                  VerticalAlignment="Center"
                  IsVisible="False">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="RotatingGrid"
                      Grid.Row="0"
                      RenderTransformOrigin="0.5, 0.5"
                      >
                        <ic:SymbolIcon
                    x:Name="LoadingIcon"
                    Foreground="{StaticResource PrimaryBrush}"
                    FontSize="108"
                    Symbol="ArrowClockwise">
                        </ic:SymbolIcon>

                        <Grid.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Grid.RenderTransform>
                        <!--
                            TODO: WPF used Grid.Triggers/EventTrigger(Loaded) + Storyboard DoubleAnimation
                            to spin SpinTransform.Angle 0->360 forever. Avalonia has no EventTrigger;
                            translated to a Style-driven Animation (see the "Grid#RotatingGrid" style
                            below) that targets the named RenderTransform via the
                            "RotateTransform.Angle" setter-property convention and runs continuously
                            (IterationCount="Infinite") once the style applies.
                        -->
                    </Grid>

                    <TextBlock
                    x:Name="UploadingTextBlock"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    FontSize="36">
                    <Run x:Name="UploadingText" Text="Uploading..." />
                    <Run x:Name="ProgressText" Text="0%" Foreground="{StaticResource PrimaryBrush}" />
                    <Run x:Name="CompleteText" Text="complete" />
                    </TextBlock>
                </Grid>

            <Grid x:Name="UploadCompletedGrid"
                  Grid.Row="2"
                  VerticalAlignment="Center"
                  IsVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ic:SymbolIcon
                    x:Name="UploadCompletedIcon"
                    Foreground="{StaticResource PrimaryBrush}"
                    Grid.Row="0"
                    FontSize="108"
                    Symbol="CheckmarkCircle" />

                <TextBlock
                    x:Name="UploadCompleteText"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    FontSize="36">Upload complete!</TextBlock>

                <TextBlock
                    Grid.Row="4"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    TextAlignment="Center"
                    VerticalAlignment="Center">
                    <Run Text="Saved to" BaselineAlignment="Center" />
                    <!--
                        TODO: WPF's Hyperlink.Inlines (icon + Run inside a Hyperlink bound to a
                        Command) has no equivalent in Avalonia. Translated to a borderless inline
                        Button (wrapped in InlineUIContainer) containing the icon and an underlined
                        TextBlock, keeping the same x:Name (FileUrlHyperlink) for the Command binding
                        and the same x:Name (FileUrlText) for the text binding (now a TextBlock.Text
                        instead of a Run.Text, both still bind via BindToStrict).
                    -->
                    <InlineUIContainer>
                        <Button x:Name="FileUrlHyperlink" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ic:SymbolIcon Symbol="ClipboardArrowRight" FontSize="20" Width="24" Height="20" />
                                <TextBlock x:Name="FileUrlText" TextDecorations="Underline" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </InlineUIContainer>
                </TextBlock>

                <Grid HorizontalAlignment="Center" Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <local:WJButton
                    x:Name="BrowseUploadsButton"
                    ButtonStyle="SemiTransparent"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    Icon="DocumentMultiple"
                    Text="Browse uploads" />

                    <local:WJButton
                    x:Name="UploadMoreFilesButton"
                    ButtonStyle="Color"
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    Icon="DocumentArrowUp"
                    Text="Upload more files" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
    <rxui:ReactiveUserControl.Styles>
        <Style Selector="Grid#RotatingGrid">
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </rxui:ReactiveUserControl.Styles>
</rxui:ReactiveUserControl>
