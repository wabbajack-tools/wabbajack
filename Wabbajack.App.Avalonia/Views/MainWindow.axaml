<Window
    x:Class="Wabbajack.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wabbajack"
    xmlns:views="using:Wabbajack.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Wabbajack"
    xmlns:fluent="using:FluentIcons.Avalonia"
    x:DataType="vm:MainWindowVM"
    Title="Wabbajack"
    Width="1441"
    Height="695"
    MinWidth="1100"
    MinHeight="500"
    Closing="Window_Closing"
    RenderOptions.BitmapInterpolationMode="HighQuality"
    CanResize="True"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaChromeHints="NoChrome"
    ExtendClientAreaTitleBarHeightHint="-1"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <!--
        TODO: The following MahApps.Metro MetroWindow properties/elements have no direct Avalonia
        equivalent and were dropped/translated as follows:
          - ShowTitleBar="False", ShowCloseButton="False", ShowMinButton="False",
            ShowMaxRestoreButton="False", TitleBarHeight="54" -> replaced with the
            ExtendClientAreaToDecorationsHint/ExtendClientAreaChromeHints/ExtendClientAreaTitleBarHeightHint
            trio above, which hides the native chrome while keeping the window resizable (CanResize),
            matching the app's fully custom-drawn title bar below.
          - WindowTitleBrush="{StaticResource BackgroundBrush}" -> dropped; there is no native title bar
            left to paint since the custom TitleBar Grid below already uses BackgroundBrush.
          - Style="{StaticResource {x:Type Window}}" (WPF implicit type-keyed style) -> dropped; Avalonia
            resolves implicit styles via Selector-based styles (e.g. Style Selector="Window"), not via a
            StaticResource Style property, so no direct substitute is needed/possible here.
          - <mahapps:MetroWindow.RightWindowCommands>/<mahapps:WindowCommands> block (Minimize/Maximize/
            Close buttons bound to MinimizeCommand/MaximizeCommand/CloseCommand) -> removed entirely;
            Avalonia has no WindowCommands/RightWindowCommands concept. The same three commands are
            already wired (via code-behind) to the custom MinimizeButton/MaximizeButton/CloseButton in the
            TitleBar Grid below, so functionality is preserved without this duplicate block.
          - <Window.TaskbarItemInfo><TaskbarItemInfo .../></Window.TaskbarItemInfo> -> removed; Avalonia has
            no TaskbarItemInfo equivalent (taskbar progress/overlay). TaskbarItemInfoControl was not
            referenced anywhere in the code-behind, so nothing else depends on it.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="FloatingWindow" Grid.Row="0" Grid.RowSpan="2" ZIndex="2">
            <Rectangle x:Name="FloatingWindowBackground" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Fill="{StaticResource BackgroundBrush}" Opacity="0.75"/>
            <Border CornerRadius="8" Margin="32" Background="{StaticResource ComplementaryBackgroundBrush}">
                <ContentControl x:Name="FloatingContentPresenter" Content="{Binding ActiveFloatingPane}" VerticalAlignment="Stretch" Margin="16">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="{x:Type local:ModListDetailsVM}">
                            <local:ModListDetailsView ViewModel="{Binding}" />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:BrowserWindowViewModel}">
                            <views:BrowserWindow ViewModel="{Binding}" />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:FileUploadVM}">
                            <local:FileUploadView ViewModel="{Binding}" />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:MegaLoginVM}">
                            <local:MegaLoginView ViewModel="{Binding}" />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:ConfirmationDialogVM}">
                            <local:ConfirmationDialogView ViewModel="{Binding}" />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </Border>
        </Grid>
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{StaticResource BackgroundBrush}" ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Border BorderThickness="0" Margin="16, 0, 8, 0" >
                <Image Grid.Column="0" Width="18" Height="18" Source="{StaticResource WabbajackLegacyLogo}"/>
            </Border>
            <TextBlock Grid.Column="1" FontSize="13" Name="AppName" VerticalAlignment="Center"></TextBlock>
            <DockPanel x:Name="WizardSteps" Grid.Column="0" Grid.ColumnSpan="7" HorizontalAlignment="Center" Margin="0, 10, 0, 10">
                <!--
                    WPF rounded these two step chips by giving a Grid an OpacityMask whose VisualBrush
                    pointed at a sibling white, rounded Border. That produced two plain white slabs here:
                    the white mask-source Border paints like any other child, and the mask did not clip
                    the content over it. CornerRadius + ClipToBounds gets the same rounded chip directly,
                    so the white scaffolding is gone entirely.
                -->
                <Border x:Name="ConfigurationChip" CornerRadius="8" ClipToBounds="True" BorderThickness="0"
                        Background="{StaticResource ComplementaryBackgroundBrush}" Margin="12, 1, 0, 1">
                    <Grid>
                        <ProgressBar x:Name="WizardConfiguration" Theme="{StaticResource FillProgressBar}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ComplementaryPrimary16Brush}" Maximum="1" Value="1" Width="{Binding ElementName=ConfigurationText, Path=Bounds.Width}" />
                        <TextBlock x:Name="ConfigurationText" Padding="12, 0, 12, 0" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border x:Name="ProgressChip" CornerRadius="8" ClipToBounds="True" BorderThickness="0"
                        Background="{StaticResource ComplementaryBackgroundBrush}" Margin="12, 1, 0, 1">
                    <Grid>
                        <ProgressBar x:Name="WizardProgress" Theme="{StaticResource FillProgressBar}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ComplementaryPrimary16Brush}" Width="{Binding ElementName=ProgressText, Path=Bounds.Width}" Maximum="1" />
                        <TextBlock x:Name="ProgressText" Padding="12, 0, 12, 0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ProgressPercentage" Padding="0, 0, 12, 0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
            </DockPanel>
            <Grid Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Classes="MainButtonStyleLessRounded" Background="{StaticResource BackgroundPrimary08Brush}" Name="LoadLocalFileButton" Padding="12, 0" Margin="0, 10, 12, 10">
                    <DockPanel>
                        <TextBlock FontSize="13" Text="Install from disk" VerticalAlignment="Center" Margin="0, 0, 8, 0" />
                        <fluent:SymbolIcon FontSize="18" Symbol="ArrowUpload" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <Button Grid.Column="1" Classes="MainButtonStyleLessRounded" Background="{StaticResource BackgroundPrimary08Brush}" Name="GetHelpButton" Padding="12, 0" Margin="0, 10, 12, 10">
                    <DockPanel>
                        <TextBlock FontSize="13" Text="Get Help" VerticalAlignment="Center" Margin="0, 0, 8, 0" />
                        <fluent:SymbolIcon FontSize="18" Symbol="QuestionCircle" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
            </Grid>
            <Button Grid.Column="4" Classes="IconBareButtonStyle" Name="MinimizeButton" Padding="12">
                <fluent:SymbolIcon Symbol="Subtract" FontSize="18"/>
            </Button>
            <Button Grid.Column="5" Classes="IconBareButtonStyle" Name="MaximizeButton" Padding="12">
                <fluent:SymbolIcon Symbol="Maximize" FontSize="18"/>
            </Button>
            <Button Grid.Column="6" Classes="IconBareButtonStyle" Name="CloseButton" Padding="12">
                <fluent:SymbolIcon Symbol="Dismiss" FontSize="18"/>
            </Button>
        </Grid>
        <Grid Grid.Row="1" x:Name="ContentRootGrid">
            <Grid.ColumnDefinitions>
                 <ColumnDefinition Width="115" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:NavigationView Grid.Column="0" ViewModel="{Binding NavigationVM}" ZIndex="1" />
            <Border Grid.Column="1" Margin="0" Background="{StaticResource ComplementaryBackgroundBrush}" x:Name="MainContent" CornerRadius="8">
                <Grid>
                    <Viewbox Stretch="Uniform" ZIndex="0">
                        <Image HorizontalAlignment="Right" Source="{StaticResource WabbajackLogoBackground}" Width="{Binding ElementName=MainContent, Path=Bounds.Width}" Height="{Binding ElementName=MainContent, Path=Bounds.Height}" RenderTransformOrigin="0.5, 0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1.7" ScaleY="1.7" />
                                    <RotateTransform Angle="15" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Viewbox>
                    <ContentControl x:Name="ActivePaneHost" Content="{Binding ActivePane}" VerticalAlignment="Stretch" Margin="16" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
