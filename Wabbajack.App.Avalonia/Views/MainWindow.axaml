<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wabbajack"
        x:Class="Wabbajack.Views.MainWindow"
        x:DataType="vm:MainWindowVM"
        Width="1280" Height="800"
        Title="Wabbajack">
  <!-- Placeholder shell during the port. The faithful MainWindow markup lives in
       port-staging/Views/MainWindow.axaml and is integrated once the DI bootstrap + theme land. -->
  <Grid>
    <TextBlock Text="Wabbajack (Avalonia) — shell integration in progress"
               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" />
  </Grid>
</Window>
