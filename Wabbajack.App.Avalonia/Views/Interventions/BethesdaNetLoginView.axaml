<UserControl
    x:Class="Wabbajack.BethesdaNetLoginView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Wabbajack"
    xmlns:vm="using:Wabbajack"
    x:DataType="vm:BethesdaNetLoginVM"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <!--
        TODO: no BethesdaNetLoginVM class exists anywhere in the current codebase (searched
        Wabbajack.App.Wpf/ViewModels, Wabbajack.App.Wpf/UserIntervention and Wabbajack.App.Core).
        This view is also not referenced by MainWindow.xaml or any other WPF file, unlike its sibling
        MegaLoginView (which is wired up in MainWindow.xaml and backed by ViewModels/Interventions/MegaLoginVM.cs).
        The image assets it points at (Resources/GameGridIcons/SkyrimSpecialEdition.png,
        Resources/GameGridIcons/Fallout4.png) also do not exist in the repo. Everything below indicates
        this view is dead/orphaned legacy code from before Bethesda.net login moved to the OAuth2-based
        BethesdaNetTokenProvider flow. x:DataType above is a best-effort guess following the View->VM
        naming convention (namespace/class do not exist yet); a human must either locate/recreate the
        real BethesdaNetLoginVM (Instructions, BackCommand, LoginViaSkyrimSE, LoginViaFallout4 members) or
        confirm this view should be dropped instead of ported forward.
    -->
    <UserControl.Resources>
        <Color x:Key="TextBackgroundFill">#92000000</Color>
        <SolidColorBrush x:Key="TextBackgroundFillBrush" Color="{StaticResource TextBackgroundFill}" />
        <Color x:Key="TextBackgroundHoverFill">#DF000000</Color>
        <!--
            TODO: trigger - the WPF style used a DataTrigger on the ancestor Button's IsMouseOver to
            ColorAnimation the TextBlock.Background between TextBackgroundFill and TextBackgroundHoverFill
            (0.06s). Avalonia has no DataTrigger/Storyboard equivalent. Also note this style is not actually
            applied to any element in this view (dead resource in the WPF source too). Nearest faithful
            translation, if this is ever wired up to a TextBlock inside a Button, would be a
            Style Selector="Button:pointerover TextBlock.BackgroundBlurStyle" setting Background to
            TextBackgroundHoverFillBrush, combined with a Transitions entry on the TextBlock for the
            0.06s ease. Left as a ControlTheme (keyed like the WPF Style) without the hover animation.
        -->
        <ControlTheme x:Key="BackgroundBlurStyle" TargetType="TextBlock">
            <Setter Property="Background" Value="{StaticResource TextBackgroundFillBrush}" />
            <Setter Property="Foreground" Value="Transparent" />
            <Setter Property="IsVisible" Value="True" />
        </ControlTheme>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="47" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <local:TopProgressView Grid.Row="0" Grid.RowSpan="2"
            Title="{Binding Instructions}"
            ShadowMargin="False" />
        <Button Grid.Row="0"
            x:Name="BackButton"
            Width="30"
            Height="30"
            Margin="7,5,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Command="{Binding BackCommand}"
            Style="{StaticResource IconCircleButtonStyle}"
            ToolTip.Tip="Back to main menu">
            <!--
                TODO: original commented-out icon used MahApps.IconPacks (iconPacks:PackIconMaterial
                Kind="ArrowLeft") bound to the ancestor Button's own Foreground - no direct Avalonia
                convention is specified for MahApps IconPacks (unlike FluentIcons.Wpf -> FluentIcons.Avalonia).
                Left commented out, unconverted, matching the WPF source's already-inactive state.
                <iconPacks:PackIconMaterial Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Kind="ArrowLeft" />
            -->
        </Button>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="100" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                Margin="10"
                FontSize="20"
                Text="Login with your game of choice. Clicking the button will launch the game. Once at the main menu, load the `Mods` menu. The game will close once you've logged into Bethesda.NET"
                TextWrapping="Wrap" />
            <Button Grid.Row="1" Grid.Column="0"
                Command="{Binding LoginViaSkyrimSE}">
                <!-- TODO: asset - Resources/GameGridIcons/SkyrimSpecialEdition.png does not exist in the repo;
                     path translated to an avares:// URI (assembly name "Wabbajack" per Wabbajack.App.Avalonia.csproj)
                     assuming Resources/** gets included as an AvaloniaResource (currently only Assets/** is). -->
                <Image Source="avares://Wabbajack/Resources/GameGridIcons/SkyrimSpecialEdition.png">
                    <Image.Styles>
                        <Style Selector="Image:disabled">
                            <Setter Property="Opacity" Value="0.5" />
                        </Style>
                    </Image.Styles>
                </Image>
            </Button>
            <Button Grid.Row="1" Grid.Column="1"
                Command="{Binding LoginViaFallout4}">
                <!-- TODO: asset - Resources/GameGridIcons/Fallout4.png does not exist in the repo; see note above. -->
                <Image Source="avares://Wabbajack/Resources/GameGridIcons/Fallout4.png">
                    <Image.Styles>
                        <Style Selector="Image:disabled">
                            <Setter Property="Opacity" Value="0.5" />
                        </Style>
                    </Image.Styles>
                </Image>
            </Button>
        </Grid>
    </Grid>
</UserControl>
