<rxui:ReactiveUserControl
    x:Class="Wabbajack.ConfirmationDialogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wabbajack"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rxui="using:Avalonia.ReactiveUI"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:vm="using:Wabbajack"
    x:DataType="vm:ConfirmationDialogVM"
    d:DesignHeight="300"
    d:DesignWidth="500"
    x:TypeArguments="vm:ConfirmationDialogVM"
    mc:Ignorable="d">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600" Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Warning Icon + Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <ic:SymbolIcon Symbol="Warning" FontSize="24" Foreground="{StaticResource WarningBrush}" Margin="0, 0, 12, 0" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Message body -->
        <TextBlock Grid.Row="2" x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource ForegroundBrush}" Opacity="0.8" />

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <local:WJButton x:Name="CancelBtn" Text="Cancel" Icon="Dismiss" ButtonStyle="Mono" Margin="0, 0, 16, 0" />
            <local:WJButton x:Name="ConfirmBtn" Text="Continue" Icon="Checkmark" ButtonStyle="Danger" />
        </StackPanel>
    </Grid>
</rxui:ReactiveUserControl>
