<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wabbajack.App.Avalonia.ViewModels"
             x:Class="Wabbajack.App.Avalonia.Views.PlaceholderView"
             x:DataType="vm:PlaceholderVM">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
        <TextBlock FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Text="{Binding Title}" />
        <TextBlock FontSize="13" Opacity="0.66" HorizontalAlignment="Center" Text="Not ported yet." />
    </StackPanel>
</UserControl>
