<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:core="using:Wabbajack"
             xmlns:local="using:Wabbajack"
             xmlns:rxui="http://reactiveui.net"
             x:Class="Wabbajack.LoginItemView"
             x:TypeArguments="core:LoginTargetVM"
             x:DataType="core:LoginTargetVM">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Image Grid.Column="0" Source="{Binding Login.Icon}" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Login.SiteName}" VerticalAlignment="Center" Margin="0,0,16,0"
                   Foreground="{DynamicResource ForegroundBrush}" />
        <local:WJButton Grid.Column="3" Text="Login" Icon="PersonArrowRight"
                        Command="{Binding Login.ToggleLogin}" />
    </Grid>
</rxui:ReactiveUserControl>
