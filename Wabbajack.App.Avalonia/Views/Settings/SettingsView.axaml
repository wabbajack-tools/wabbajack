<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:core="using:Wabbajack"
             xmlns:local="using:Wabbajack"
             xmlns:rxui="http://reactiveui.net"
             x:Class="Wabbajack.SettingsView"
             x:TypeArguments="core:SettingsVM"
             x:DataType="core:SettingsVM">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="16">
            <local:LoginSettingsView DataContext="{Binding LoginVM}" ViewModel="{Binding LoginVM}" />
            <local:PerformanceSettingsView DataContext="{Binding PerformanceVM}" ViewModel="{Binding PerformanceVM}" />
            <local:AboutView DataContext="{Binding AboutVM}" ViewModel="{Binding AboutVM}" />
            <local:MiscSettingsView DataContext="{Binding}" ViewModel="{Binding}" />
            <local:FileUploadSettingsView DataContext="{Binding}" ViewModel="{Binding}" />
        </StackPanel>
    </ScrollViewer>
</rxui:ReactiveUserControl>
