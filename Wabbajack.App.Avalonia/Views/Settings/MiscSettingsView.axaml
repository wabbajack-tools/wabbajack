<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:core="using:Wabbajack"
             xmlns:local="using:Wabbajack"
             xmlns:rxui="http://reactiveui.net"
             x:Class="Wabbajack.MiscSettingsView"
             x:TypeArguments="core:SettingsVM"
             x:DataType="core:SettingsVM">
    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8">
        <StackPanel Margin="16" Spacing="16">
            <TextBlock Text="Miscellaneous" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Left">
                <local:WJButton Text="Launch CLI" Icon="WindowConsole" ButtonStyle="Mono"
                                Command="{Binding LaunchCLICommand}" />
                <local:WJButton Text="Reset Wabbajack" Icon="ArrowReset" ButtonStyle="Danger"
                                Command="{Binding ResetCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</rxui:ReactiveUserControl>
