<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:core="using:Wabbajack"
             xmlns:local="using:Wabbajack"
             xmlns:rxui="http://reactiveui.net"
             x:Class="Wabbajack.LoginSettingsView"
             x:TypeArguments="core:LoginManagerVM"
             x:DataType="core:LoginManagerVM">
    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8">
        <Grid Margin="16" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="Logins" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"
                       Foreground="{DynamicResource ForegroundBrush}" />
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Logins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:LoginTargetVM">
                        <local:LoginItemView DataContext="{Binding}" ViewModel="{Binding}" Margin="0,0,0,8" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</rxui:ReactiveUserControl>
