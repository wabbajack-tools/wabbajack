<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:core="using:Wabbajack"
             xmlns:local="using:Wabbajack"
             xmlns:rxui="http://reactiveui.net"
             x:Class="Wabbajack.FileUploadSettingsView"
             x:TypeArguments="core:SettingsVM"
             x:DataType="core:SettingsVM">
    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8">
        <StackPanel Margin="16" Spacing="16">
            <TextBlock Text="Wabbajack CDN" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Left">
                <local:WJButton Text="Upload a file" Icon="DocumentArrowUp" ButtonStyle="Color"
                                Command="{Binding OpenFileUploadCommand}" />
                <local:WJButton Text="Browse uploads" Icon="DocumentMultiple" ButtonStyle="Mono"
                                Command="{Binding BrowseUploadsCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</rxui:ReactiveUserControl>
