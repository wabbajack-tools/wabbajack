<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:core="using:Wabbajack"
             xmlns:local="using:Wabbajack"
             xmlns:rxui="http://reactiveui.net"
             x:Class="Wabbajack.InstallationView"
             x:TypeArguments="core:InstallationVM"
             x:DataType="core:InstallationVM">
    <Grid Margin="16">

        <!-- ============================ Configuration ============================ -->
        <Grid IsVisible="{Binding InstallState, Converter={StaticResource EnumEquals}, ConverterParameter=Configuration}"
              ColumnDefinitions="2.35*,16,3*">
            <!-- Left: modlist image -->
            <local:DetailImageView Grid.Column="0"
                                   TitleFontSize="36" AuthorFontSize="16"
                                   Image="{Binding ModListImage}"
                                   Title="{Binding ModList.Name}"
                                   Author="{Binding ModList.Author}"
                                   Version="{Binding ModList.Version}"
                                   VerticalAlignment="Stretch" />

            <!-- Right: configuration -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="{Binding ConfigurationText}"
                           FontSize="24" FontWeight="DemiBold" Margin="0,0,0,16"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundBrush}" />

                <local:MO2InstallerConfigView Grid.Row="1" Margin="0,0,0,16"
                                              DataContext="{Binding Installer}"
                                              ViewModel="{Binding Installer}" />

                <!-- Preflight summary (minimal) -->
                <Border Grid.Row="2" Margin="0,0,0,16" Padding="12"
                        CornerRadius="4"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource ComplementaryPrimary08Brush}"
                        IsVisible="{Binding Preflight, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="CheckmarkCircle" IconVariant="Filled"
                                       FontSize="20"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="Preflight checks:" />
                            <Run Text="{Binding Preflight.PassedCount}" />
                            <Run Text="/" />
                            <Run Text="{Binding Preflight.TotalCount}" />
                            <Run Text="passed" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Links -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Top">
                    <Button Classes="link" Content="Open Readme" Command="{Binding OpenReadmeCommand}" />
                    <Button Classes="link" Content="Open Website" Command="{Binding OpenWebsiteCommand}" />
                </StackPanel>

                <!-- Action buttons -->
                <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto">
                    <local:WJButton Grid.Column="0"
                                    Text="Back to Gallery" Icon="ChevronLeft"
                                    ButtonStyle="Mono"
                                    Command="{Binding BackToGalleryCommand}"
                                    HorizontalAlignment="Left" />
                    <local:WJButton Grid.Column="2"
                                    Text="Install" Icon="Play"
                                    ButtonStyle="Color"
                                    Command="{Binding InstallCommand}"
                                    HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================ Installing ============================ -->
        <Grid IsVisible="{Binding InstallState, Converter={StaticResource EnumEquals}, ConverterParameter=Installing}"
              ColumnDefinitions="2.35*,16,3*">

            <!-- Left: progress + workers + cpu -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*">
                <TextBlock Grid.Row="0" Text="{Binding ProgressText}"
                           FontSize="20" FontWeight="DemiBold" Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ForegroundBrush}" />

                <ProgressBar Grid.Row="1" Minimum="0" Maximum="1"
                             Value="{Binding ProgressPercent.Value}"
                             Height="8" Margin="0,0,0,16" />

                <!-- Worker speed indicators -->
                <Grid Grid.Row="2" Margin="0,0,0,16"
                      ColumnDefinitions="*,16,*,16,*">
                    <Border Grid.Column="0" BorderThickness="2" CornerRadius="4" Padding="8"
                            BorderBrush="{DynamicResource ComplementaryPrimary08Brush}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <ic:SymbolIcon Grid.Column="0" Symbol="NumberSymbol" FontSize="18"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="Validation"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Grid.Column="3" Text="{Binding HashingSpeed}"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" BorderThickness="2" CornerRadius="4" Padding="8"
                            BorderBrush="{DynamicResource ComplementaryPrimary08Brush}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <ic:SymbolIcon Grid.Column="0" Symbol="Dock" FontSize="18"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="Extraction"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Grid.Column="3" Text="{Binding ExtractingSpeed}"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="4" BorderThickness="2" CornerRadius="4" Padding="8"
                            BorderBrush="{DynamicResource ComplementaryPrimary08Brush}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <ic:SymbolIcon Grid.Column="0" Symbol="ArrowDownload" FontSize="18"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="Download"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Grid.Column="3" Text="{Binding DownloadingSpeed}"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </Grid>
                    </Border>
                </Grid>

                <local:CpuView Grid.Row="3" DataContext="{Binding}" ViewModel="{Binding}" />
            </Grid>

            <!-- Right: log + cancel -->
            <Grid Grid.Column="2" RowDefinitions="*,16,Auto">
                <local:LogView Grid.Row="0" DataContext="{Binding LoggerProvider}" />
                <local:WJButton Grid.Row="2"
                                Text="Cancel" Icon="Dismiss"
                                ButtonStyle="Danger"
                                Command="{Binding CancelCommand}"
                                HorizontalAlignment="Right" />
            </Grid>
        </Grid>

        <!-- ============================ Success ============================ -->
        <Grid IsVisible="{Binding InstallState, Converter={StaticResource EnumEquals}, ConverterParameter=Success}"
              RowDefinitions="*,16,Auto">
            <local:DetailImageView Grid.Row="0"
                                   TitleFontSize="60" AuthorFontSize="27"
                                   Image="{Binding ModListImage}"
                                   Title="{Binding ModList.Name}"
                                   Author="{Binding ModList.Author}"
                                   Version="{Binding ModList.Version}" />
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,16,Auto">
                <local:WJButton Grid.Column="0"
                                Text="Back to Gallery" Icon="ChevronLeft"
                                ButtonStyle="Mono"
                                Command="{Binding BackToGalleryCommand}"
                                HorizontalAlignment="Left" />
                <local:WJButton Grid.Column="2"
                                Text="Open Readme" Icon="WindowNew"
                                ButtonStyle="Mono"
                                Command="{Binding OpenReadmeCommand}"
                                HorizontalAlignment="Right" />
                <local:WJButton Grid.Column="4"
                                Text="Open in File Explorer" Icon="FolderOpen"
                                ButtonStyle="Color"
                                Command="{Binding OpenInstallFolderCommand}"
                                HorizontalAlignment="Right" />
            </Grid>
        </Grid>

        <!-- ============================ Failure ============================ -->
        <Grid IsVisible="{Binding InstallState, Converter={StaticResource EnumEquals}, ConverterParameter=Failure}">
            <Border CornerRadius="8" Padding="32"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid VerticalAlignment="Center"
                      RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Text="Installation failed" FontSize="18"
                               Foreground="{DynamicResource Transparent66ForegroundBrush}" />
                    <TextBlock Grid.Row="1" Text="{Binding FailureDetailsTitle}"
                               FontWeight="SemiBold" FontSize="40" Margin="0,-4,0,8"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <TextBlock Grid.Row="2" Text="{Binding FailureDetailsDescription}"
                               FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,24,0,0">
                        <local:WJButton Text="Retry" Icon="ArrowCounterclockwise"
                                        ButtonStyle="Color"
                                        Command="{Binding EditInstallDetailsCommand}" />
                        <local:WJButton Text="Open Logs Folder" Icon="FolderOpen"
                                        ButtonStyle="SemiTransparent"
                                        Command="{Binding OpenLogFolderCommand}" />
                        <local:WJButton Text="Back to Gallery" Icon="ChevronLeft"
                                        ButtonStyle="Mono"
                                        Command="{Binding BackToGalleryCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</rxui:ReactiveUserControl>
