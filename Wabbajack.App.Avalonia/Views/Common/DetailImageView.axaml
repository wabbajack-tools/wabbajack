<rxui:ReactiveUserControl
    x:Class="Wabbajack.DetailImageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wabbajack"
    xmlns:vm="using:Wabbajack"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rxui="using:Avalonia.ReactiveUI"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="vm:ViewModel"
    x:DataType="vm:ViewModel"
    ClipToBounds="True"
    mc:Ignorable="d">
    <Border x:Name="BorderMask2" CornerRadius="8" BorderThickness="0" Background="White">
        <Grid>
            <Border Name="BorderMask" CornerRadius="8" Background="White" Margin="1"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.OpacityMask>
                    <VisualBrush Visual="{Binding #BorderMask}" />
                </Grid.OpacityMask>
                <Rectangle Grid.RowSpan="4" Fill="{StaticResource ComplementaryPrimary08Brush}" IsVisible="{Binding ElementName=ModlistImage, Path=Source, Converter={StaticResource IsNotNullVisibilityConverter}}"/>
                <Rectangle Grid.RowSpan="4" Fill="Black"/>
                <!--
                    Two departures from the WPF source, both needed to make the banner visible at all
                    - it rendered as a solid black box on the installer, with only the title and
                    author drawn over it:

                    - WPF wrapped this Image in a Viewbox for UniformToFill. Avalonia's Image applies
                      Stretch itself, and its Viewbox measures children with an infinite constraint,
                      so the wrapper is both unnecessary and harmful here.
                    - WPF faded the bottom of the image with an Image.OpacityMask. Avalonia draws an
                      element carrying that mask as fully transparent, so the same fade is done with
                      an overlay gradient below instead: transparent over the top half, opaque black
                      by the bottom, which is what the mask was compositing against anyway.
                -->
                <Image x:Name="ModlistImage"
                       Grid.RowSpan="4"
                       Stretch="UniformToFill" />
                <Rectangle Grid.RowSpan="4" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0.0" Color="#00000000" />
                            <GradientStop Offset="0.5" Color="#00000000" />
                            <GradientStop Offset="1.0" Color="#FF000000" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!--
                    <Rectangle
                            Margin="-80, 0, -80, -75"
                            VerticalAlignment="Bottom"
                            Fill="Black"
                            Opacity="0.7">
                        <Rectangle.Effect>
                            <BlurEffect Radius="100" />
                        </Rectangle.Effect>
                    </Rectangle>
                    -->
                <TextBlock Grid.Row="2"
            x:Name="TitleTextBlock"
            Margin="16, 0, 0, 0"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            FontWeight="Bold"
            TextWrapping="WrapWithOverflow">
                </TextBlock>
                <StackPanel Grid.Row="3" Margin="16, 0, 0, 16" Orientation="Horizontal">
                    <StackPanel.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="Margin" Value="0,0,8,0" />
                        </Style>
                    </StackPanel.Styles>
                    <TextBlock x:Name="VersionPrefixText" Text="version" Foreground="{StaticResource Transparent66ForegroundBrush}" />
                    <TextBlock x:Name="VersionText" />
                    <TextBlock x:Name="AuthorPrefixText" Text="by" Foreground="{StaticResource Transparent66ForegroundBrush}" />
                    <TextBlock x:Name="AuthorText" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</rxui:ReactiveUserControl>
