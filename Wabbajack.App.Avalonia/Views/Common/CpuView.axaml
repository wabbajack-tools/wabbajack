<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:Wabbajack"
             xmlns:local="using:Wabbajack"
             xmlns:rxui="http://reactiveui.net"
             x:Class="Wabbajack.CpuView"
             x:TypeArguments="core:ICpuStatusVM"
             x:DataType="core:ICpuStatusVM">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding StatusList}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:CpuLineView Margin="0,0,0,8" DataContext="{Binding}" ViewModel="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</rxui:ReactiveUserControl>
