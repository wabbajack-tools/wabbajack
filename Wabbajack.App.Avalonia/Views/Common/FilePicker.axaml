<UserControl
    x:Class="Wabbajack.FilePicker"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wabbajack"
    xmlns:fluent="using:FluentIcons.Avalonia"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="35"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <Grid Height="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Rectangle Grid.Column="0" Grid.ColumnSpan="2"
            x:Name="ErrorGlow"
            Fill="{StaticResource WarningBrush}"
            Opacity="0.3"
            IsVisible="{Binding #Root.PickerVM.InError}"
            Classes.inError="{Binding #Root.PickerVM.InError}">
            <Rectangle.Effect>
                <BlurEffect Radius="15" />
            </Rectangle.Effect>
            <!--
                WPF used a Style.Triggers/DataTrigger + Storyboard ColorAnimation to pulse the
                Fill color between WarningBrush and YellowDark forever while InError is true.
                Avalonia has no DataTrigger; translated to a binding-driven style class
                ("inError", bound above) that plays an Animation defined below whenever the
                class is present. See the "Rectangle.inError" style at the bottom of this file.
            -->
        </Rectangle>
        <Border Grid.Column="0" Grid.ColumnSpan="2"
            x:Name="BackgroundCornerFillIn"
            Margin="0, 0, 5, 0"
            Background="{StaticResource TextBoxBackground}"
            CornerRadius="4" />
        <TextBox Grid.Column="0"
            x:Name="PathTextBox"
            Margin="4, 0, 0, 0"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center"
            Background="{StaticResource DarkBackgroundBrush}"
            Text="{Binding #Root.PickerVM.TargetPath, Mode=TwoWay, Converter={StaticResource AbsolutePathToStringConverter}}"
            Watermark="{Binding #Root.Watermark}"
            />
        <!--
            A TextBox cannot ellipsize - Avalonia has no TextTrimming on it - so a long path was
            simply cut off mid-word at the field's edge ("Z:\Modlists\TempusMaledictum\downloa").
            This TextBlock sits over the TextBox and renders the same value trimmed whenever the
            field is not being edited; clicking in hands over to the real TextBox with the full text.

            PrefixCharacterEllipsis puts the ellipsis at the start, so the leaf folder - the part
            that actually distinguishes one path from another - stays readable.

            Hidden while the text is empty so the TextBox's own watermark shows through, and while
            focused so it never covers the caret. Padding rather than a right margin: the background
            still has to cover the full field or the TextBox's text shows past the ellipsis.
        -->
        <Border Grid.Column="0"
            x:Name="PathDisplay"
            Margin="4, 0, 0, 0"
            IsHitTestVisible="False"
            Background="{Binding #PathTextBox.Background}">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding ElementName="PathTextBox" Path="IsFocused"
                             Converter="{x:Static conv:BoolConverters.Not}" />
                    <Binding ElementName="PathTextBox" Path="Text"
                             Converter="{x:Static conv:StringConverters.IsNotNullOrEmpty}" />
                </MultiBinding>
            </Border.IsVisible>
            <!-- IsHitTestVisible has to be repeated on the child: setting it on the Border alone
                 excludes the Border but not its subtree, so this TextBlock swallowed the click and
                 the path field could no longer be focused by clicking it (measured - the same click
                 focuses it with this overlay removed). -->
            <TextBlock
                Margin="8, 0, 10, 0"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                TextTrimming="PrefixCharacterEllipsis"
                Text="{Binding #PathTextBox.Text}" />
        </Border>
        <Grid Grid.Column="1"
            HorizontalAlignment="Right"
            ClipToBounds="True">
            <Border
                Width="32"
                HorizontalAlignment="Right"
                BorderThickness="0"
                CornerRadius="4">
                <Button Command="{Binding #Root.PickerVM.SetTargetPathCommand}" Classes="MainButtonStyle" Background="Transparent" ToolTip.Tip="Set target path">
                    <fluent:SymbolIcon FontSize="18" Symbol="{Binding #Root.Icon}" />
                </Button>
            </Border>
        </Grid>
        <Border Grid.Column="0" Grid.ColumnSpan="2"
            x:Name="ErrorBorder"
            Background="Transparent"
            BorderBrush="{StaticResource WarningBrush}"
            BorderThickness="1"
            CornerRadius="4"
            IsHitTestVisible="False"
            IsVisible="{Binding #Root.PickerVM.InError}"
            Classes.inError="{Binding #Root.PickerVM.InError}" />
    </Grid>
    <UserControl.Styles>
        <!--
            Pulsing color animation replacing the WPF DataTrigger/Storyboard ColorAnimation
            (AutoReverse -> PlaybackDirection="Alternate", RepeatBehavior="Forever" ->
            IterationCount="Infinite"). Only plays while the "inError" class is applied.
        -->
        <Style Selector="Rectangle.inError">
            <Style.Animations>
                <Animation Duration="0:0:0.8" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Fill">
                            <SolidColorBrush Color="{StaticResource YellowDark}" />
                        </Setter>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.inError">
            <Style.Animations>
                <Animation Duration="0:0:0.8" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="BorderBrush">
                            <SolidColorBrush Color="{StaticResource YellowDark}" />
                        </Setter>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
</UserControl>
