<Button
    x:Name="WJButtonElement"
    x:Class="Wabbajack.WJButton"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wabbajack"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:fluent="using:FluentIcons.Avalonia"
    x:DataType="local:WJButtonVM"
    ClipToBounds="True"
    d:DesignHeight="38"
    d:DesignWidth="200"
    Height="38"
    mc:Ignorable="d">
    <!--
        WPF hard-coded Width="200" here and let each call site override it - twelve of them with
        Width="Auto" to stretch, six with an explicit number. Avalonia's Width takes no "Auto", so
        the port dropped every one of those overrides, which left all 46 WJButtons stuck at exactly
        200px: the modlist detail's Website/Discord/Install row, the installer's link buttons and the
        compiler's Publish buttons all sat at an arbitrary width in cells sized for something else.
        The default now lives at the call sites instead, so "stretch" is simply the absence of Width.
    -->
    <!--
        WPF's RelativeSource FindAncestor/AncestorType=Button (from this Grid, the
        nearest Button ancestor in the visual tree is this control itself, since the
        Grid is this Button's own Content) becomes Avalonia's $parent[Button] ancestor
        binding. Bounds.Width is Avalonia's ActualWidth equivalent.
    -->
    <Grid Width="{Binding $parent[Button].Bounds.Width}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="ButtonTextBlock" VerticalAlignment="Center" Margin="10, 4, 10, 4" />
        <fluent:SymbolIcon x:Name="ButtonSymbolIcon" FontSize="18" VerticalAlignment="Center" Margin="10, 4, 10, 4" />
    </Grid>
</Button>
