<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:ic="using:FluentIcons.Avalonia"
                          xmlns:vm="using:Wabbajack.App.Avalonia.ViewModels.Common"
                          x:Class="Wabbajack.App.Avalonia.Views.Common.CpuLineView"
                          x:TypeArguments="vm:CPUDisplayVM"
                          x:DataType="vm:CPUDisplayVM">
    <!--
        One running job: a 32px rounded bar filled as far as the job has got, an icon for the kind of job, its
        name and a percentage. WPF masked a 32px grid inside a -1 margin, so the line lays out 30px tall and
        draws a pixel past its box on every side; the -1 margin here does the same, and the list around it
        clips that pixel exactly as WPF's did. The white border WPF masked against is always covered.
    -->
    <UserControl.Styles>
        <!-- MetroProgressBar with a transparent track, no border and no minimum size: the filled part only. -->
        <Style Selector="ProgressBar.cpuLine">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Border Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>
    <Grid Margin="-1">
        <Border Height="32" CornerRadius="8" ClipToBounds="True" Background="{StaticResource ComplementaryPrimary08Brush}">
            <Grid ColumnDefinitions="*,Auto">
                <ProgressBar x:Name="BackgroundProgressBar" Grid.ColumnSpan="2" Classes="cpuLine"
                             Minimum="0" Maximum="1" Foreground="{StaticResource ComplementaryPrimary16Brush}" />
                <ic:SymbolIcon x:Name="Icon" FontSize="18" Foreground="{StaticResource PrimaryBrush}" Margin="8,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="False" />
                <TextBlock x:Name="Text" Margin="32,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" TextWrapping="NoWrap" />
                <TextBlock x:Name="Progress" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,0,8,0" />
            </Grid>
        </Border>
    </Grid>
</rxui:ReactiveUserControl>
