<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:Wabbajack"
             xmlns:rxui="http://reactiveui.net"
             x:Class="Wabbajack.CpuLineView"
             x:TypeArguments="core:CPUDisplayVM"
             x:DataType="core:CPUDisplayVM">
    <Border CornerRadius="8" ClipToBounds="True" Height="32" Background="{DynamicResource ComplementaryPrimary08Brush}">
        <Grid ColumnDefinitions="*,Auto">
            <ProgressBar Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource ComplementaryPrimary16Brush}"
                         Minimum="0" Maximum="1" Value="{Binding ProgressPercent.Value}" />
            <TextBlock Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       Foreground="{DynamicResource ForegroundBrush}"
                       Text="{Binding Msg}" />
        </Grid>
    </Border>
</rxui:ReactiveUserControl>
