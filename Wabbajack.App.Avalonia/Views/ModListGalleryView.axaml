<rxui:ReactiveUserControl
    x:Class="Wabbajack.ModListGalleryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wabbajack"
    xmlns:vm="using:Wabbajack"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rxui="using:Avalonia.ReactiveUI"
    xmlns:ic="using:FluentIcons.Avalonia"
    d:DesignHeight="450"
    d:DesignWidth="900"
    x:TypeArguments="vm:ModListGalleryVM"
    x:DataType="vm:ModListGalleryVM"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <!-- WPF's mahapps:TextBoxHelper.Watermark attached property maps to Avalonia
                         TextBox's own Watermark property. -->
                    <TextBox
                        x:Name="SearchBox"
                        Watermark="Search for a modlist..." />
                    <Border BorderThickness="0" CornerRadius="8" Width="30"
                            Background="{StaticResource ComplementaryPrimary08Brush}" HorizontalAlignment="Right">
                        <ic:SymbolIcon Symbol="Search" HorizontalAlignment="Center" IconVariant="Filled"
                                       Foreground="{StaticResource PrimaryBrush}" />
                    </Border>
                </Grid>
                <ComboBox
                    Grid.Row="1"
                    Margin="0, 12, 0, 0"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding GameTypeEntries, Mode=TwoWay}"
                    SelectedItem="{Binding SelectedGameTypeEntry, Mode=TwoWay}"
                    ToolTip.Tip="Filter modlists on game">
                    <!-- TODO: WPF's IsSynchronizedWithCurrentItem (ICollectionView concept) has no
                         Avalonia equivalent; dropped since the ItemsSource/SelectedItem two-way
                         bindings already keep the current selection synchronized with the VM. -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0, 2, 0, 2">
                                <Border Width="24" Height="24" BorderThickness="0" CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <!-- WPF's ImageBrush.ImageSource maps to Avalonia ImageBrush.Source. -->
                                        <ImageBrush Stretch="Fill" Source="{Binding GameMetaData.IconSource}" />
                                    </Border.Background>
                                </Border>
                                <TextBlock Margin="10, 0, 0, 0" Text="{Binding FormattedName}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Row="2" Margin="0, 12, 0, 12" Orientation="Vertical">
                    <Label Margin="0, 0, 0, 4">Include</Label>
                    <Border CornerRadius="8" Background="{StaticResource ComplementaryPrimary08Brush}"
                            Padding="0, 12, 0, 12">
                        <StackPanel Orientation="Vertical">
                            <!-- WPF's Background here tinted only the check glyph's square. Avalonia's
                                 Fluent template template-binds Background on the checkbox root instead,
                                 so keeping it painted an opaque slab behind the label as well. Dropped:
                                 the glyph square already reads correctly against the card. -->
                            <CheckBox x:Name="IncludeUnofficial"
                                      Margin="12, 0, 0, 12"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource ForegroundBrush}"
                                      ToolTip.Tip="Show modlists that have not been tested to provide a stable experience with official support channels. More info about featured modlists is available on the Wabbajack wiki.">
                                <TextBlock FontSize="10" Text="Non-featured" />
                            </CheckBox>
                            <CheckBox x:Name="IncludeNSFW"
                                      Margin="12, 0, 0, 0"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource ForegroundBrush}"
                                      ToolTip.Tip="Show modlists that include NSFW frameworks.">
                                <TextBlock FontSize="10" Text="NSFW" />
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0, 12, 0, 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" FontSize="13" Text="Total Modlist Size" />
                    <!-- TODO: MahApps.Metro's RangeSlider (dual-thumb Minimum/Maximum/LowerValue/
                         UpperValue slider, styled via the SliderHelper attached properties) has no
                         Avalonia built-in or previously-ported equivalent. Stubbed here as a custom
                         local:RangeSlider control that preserves the exact same property surface
                         (MinRangeWidth, AutoToolTipPlacement, AutoToolTipPrecision, Minimum, Maximum,
                         LowerValue, UpperValue, TrackValueFillBrush, ThumbFillBrush,
                         ThumbFillHoverBrush, ThumbFillPressedBrush) so the code-behind bindings in
                         ModListGalleryView.axaml.cs keep compiling unchanged. A real dual-thumb
                         slider implementation (custom control or third-party package) still needs to
                         be supplied for this control to render/function. -->
                    <local:RangeSlider Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="1" Margin="0, 10, 0, 0"
                                       x:Name="SizeSliderFilter"
                                       AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1"
                                       TrackValueFillBrush="{StaticResource PrimaryBrush}"
                                       ThumbFillBrush="{StaticResource PrimaryBrush}"
                                       ThumbFillHoverBrush="{StaticResource PrimaryBrush}"
                                       ThumbFillPressedBrush="{StaticResource PrimaryBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="{Binding #SizeSliderFilter.Minimum, Converter={StaticResource MathConverter}, ConverterParameter='Round(x,1)', StringFormat={}{0} GB}"
                               Foreground="{StaticResource ComplementaryWhite25Brush}" Margin="0, 4, 0, 0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"
                               Text="{Binding #SizeSliderFilter.Maximum, Converter={StaticResource MathConverter}, ConverterParameter='Round(x,1)', StringFormat={}{0} GB}"
                               Foreground="{StaticResource ComplementaryWhite25Brush}" Margin="0, 4, 0, 0" />
                </Grid>

                <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0, 24, 0, 0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Has mod(s)" VerticalAlignment="Center" />
                        <CheckBox x:Name="ExcludeModsCheckbox"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  ToolTip.Tip="Exclude modlists containing the selected mods instead of including them">
                            <TextBlock FontSize="10" Text="Exclude" />
                        </CheckBox>
                    </Grid>
                    <!-- TODO: SDL WPF Toolkit's sdl:MultiSelectComboBox (IsEditable + SelectionMode=
                         "Multiple" + SelectedItems, with a SelectedItemsChanged event) has no
                         Avalonia built-in or previously-ported equivalent. Stubbed here as a custom
                         local:MultiSelectComboBox control preserving the same property surface
                         (IsEditable, SelectionMode, ItemsSource, SelectedItems) and a
                         SelectedItemsChanged event, so the code-behind (including the
                         .Events().SelectedItemsChanged subscription) keeps compiling unchanged. A
                         real implementation still needs to be supplied. -->
                    <local:MultiSelectComboBox
                        x:Name="HasModsFilter"
                        Margin="0, 12, 0, 0"
                        IsEditable="True"
                        SelectionMode="Multiple"
                        Background="{StaticResource ComplementaryPrimary08Brush}" />
                </StackPanel>

                <StackPanel Grid.Row="5" Orientation="Vertical" Margin="0, 24, 0, 0">
                    <TextBlock Text="Has tag(s)" />
                    <local:MultiSelectComboBox
                        x:Name="HasTagsFilter"
                        Margin="0, 12, 0, 0"
                        IsEditable="True"
                        SelectionMode="Multiple"
                        Background="{StaticResource ComplementaryPrimary08Brush}" />
                </StackPanel>

                <CheckBox
                    Grid.Row="6"
                    x:Name="OnlyInstalledCheckbox"
                    Margin="0, 24, 0, 0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource ForegroundBrush}"
                    ToolTip.Tip="Show only modlists for games you have installed on your PC">
                    <TextBlock Text="Show only modlists for installed games" FontSize="10"
                               VerticalAlignment="Center" />
                </CheckBox>

                <local:WJButton
                    x:Name="ResetFiltersButton"
                    Margin="0, 24, 0, 0"
                    Grid.Row="7"
                    ToolTip.Tip="Reset filters to the default options"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Icon="FilterDismiss"
                    Text="Reset filters"
>
                </local:WJButton>
            </Grid>
        </ScrollViewer>
        <Border Grid.Column="1"
                BorderBrush="Transparent"
                BorderThickness="0"
                Margin="0, 0, 0, -16">
            <!-- HorizontalScrollBarVisibility must be Disabled so the WrapPanel is measured against
                 the viewport width and reflows into as many tile columns as fit; otherwise it is
                 measured unconstrained and stays at the column count from the initial layout. -->
            <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl
                    x:Name="ModListGalleryControl"
                    HorizontalAlignment="Stretch"
                    ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:ModListTileView ViewModel="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <!-- MahApps ProgressRing has no Avalonia equivalent control; swapped for an indeterminate
             ProgressBar. -->
        <ProgressBar Grid.Column="1"
                     x:Name="LoadingRing"
                     IsIndeterminate="True"
                     IsVisible="False" />
        <StackPanel Grid.Column="1"
                    x:Name="NoneFound"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical"
                    IsVisible="False">
            <ic:SymbolIcon
                Foreground="{StaticResource Triadic2Brush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Symbol="DismissCircle"
                IconVariant="Regular"
                FontSize="72" />
            <TextBlock
                FontSize="24"
                Margin="0, 8, 0, 0"
                Foreground="{StaticResource ForegroundBrush}"
                Text="No modlists matching specified criteria" />
        </StackPanel>
        <Grid x:Name="ProtocolOverlay"
            Grid.ColumnSpan="2"
            IsVisible="False"
            Background="#80000000"
            ZIndex="9999">
            <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="420">
                <ProgressBar Width="56" Height="56" IsIndeterminate="True" />
                <TextBlock x:Name="ProtocolOverlayText"
                   Margin="0,16,0,0"
                   TextAlignment="Center"
                   FontSize="16"
                   Foreground="White"
                   TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                   TextAlignment="Center"
                   FontSize="12"
                   Foreground="#CCFFFFFF"
                   Text="Downloading modlist file…" />
            </StackPanel>
        </Grid>
        <!-- Kept commented out verbatim from the WPF source (was already disabled there). If ever
             reinstated, iconPacks:PackIconControl (MahApps.Metro.IconPacks) would need to be
             translated to FluentIcons.Avalonia's ic:SymbolIcon (or another Avalonia icon pack), and
             Visibility="Collapsed" would become IsVisible="False".
        <iconPacks:PackIconControl Grid.Row="1" Grid.Column="0"
                                   x:Name="ErrorIcon"
                                   Width="55"
                                   Height="55"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Kind="{x:Static iconPacks:PackIconMaterialKind.AlertCircle}"
                                   ToolTip="Error loading modlist gallery"
                                   Visibility="Collapsed" />-->
    </Grid>
</rxui:ReactiveUserControl>
