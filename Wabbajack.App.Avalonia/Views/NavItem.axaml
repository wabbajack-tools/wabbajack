<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:v="using:Wabbajack.App.Avalonia.Views"
             x:Class="Wabbajack.App.Avalonia.Views.NavItem"
             x:DataType="v:NavItem">
    <!-- One rail item: icon over label, with the accent bar the active style shows on the left edge. -->
    <Grid>
        <Border Classes="accent" Width="5" Height="40" CornerRadius="3" HorizontalAlignment="Left"
                Background="{StaticResource PrimaryBrush}" />
        <Grid RowDefinitions="*,Auto" Margin="0,12">
            <ic:SymbolIcon Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36"
                           Foreground="{StaticResource PrimaryBrush}"
                           Symbol="{Binding Symbol, RelativeSource={RelativeSource AncestorType=v:NavItem}}" />
            <TextBlock Grid.Row="1" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"
                       Text="{Binding Text, RelativeSource={RelativeSource AncestorType=v:NavItem}}" />
        </Grid>
    </Grid>
</UserControl>
