<rxui:ReactiveUserControl
    x:Class="Wabbajack.CompilerMainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wabbajack"
    xmlns:vm="using:Wabbajack"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rxui="using:Avalonia.ReactiveUI"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="vm:CompilerMainVM"
    x:DataType="vm:CompilerMainVM"
    mc:Ignorable="d">
    <Grid>
        <Grid x:Name="MainContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <!-- TODO: MathConverter has no Avalonia build (see PORT_PLAN.md). The WPF binding computed
                 Height = ActualWidth / (16/9) to keep a 16:9 aspect ratio off the element's own measured
                 width. Replace with a dedicated value converter (e.g. AspectRatioConverter taking a
                 ratio ConverterParameter) or a VM-level computed property. Left wired to Bounds.Width
                 with the same StaticResource key so the intent is preserved until that converter exists. -->
            <local:DetailImageView x:Name="DetailImage" TitleFontSize="40" AuthorFontSize="18" Margin="0, 0, 0, 16" Height="{Binding #DetailImage.Bounds.Width, Converter={StaticResource MathConverter}, ConverterParameter=x/(16/9)}" />
            <local:CompilerDetailsView x:Name="CompilerDetailsView" Grid.Row="1" Grid.RowSpan="2" ViewModel="{Binding CompilerDetailsVM}" />

            <local:CompilerFileManagerView x:Name="FileManager" ViewModel="{Binding CompilerFileManagerVM}" Grid.Column="1" Grid.RowSpan="2" Margin="16, 0, 0, 0" />
            <DockPanel x:Name="ConfigurationButtons" Grid.Row="2" Grid.Column="1" Margin="0, 16, 0, 0">
                <!-- TODO: ToolTipService.ShowOnDisabled has no direct Avalonia equivalent; Avalonia
                     ToolTips are shown via the ToolTip.Tip attached property and are not suppressed
                     on disabled controls by default, so the attribute was dropped. -->
                <local:WJButton Width="200" x:Name="StartButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Text="Compile List" Icon="Box" ButtonStyle="Color"/>
            </DockPanel>

            <Grid x:Name="CompilationButtons" Grid.Row="2" Grid.Column="1" Margin="0, 16, 0, 0" IsVisible="True" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:WJButton Width="200" x:Name="CancelButton" Text="Cancel" Icon="DismissCircle" ButtonStyle="Danger" Grid.Column="1" Margin="16, 0, 0, 0" HorizontalAlignment="Right"/>
                <local:WJButton Width="200" Text="Open in File Explorer" Icon="Folder" IsEnabled="False" Grid.Column="2" Margin="16, 0, 0, 0" HorizontalAlignment="Right" />
                <local:WJButton Width="200" Text="Publish Modlist" Icon="CloudArrowUp" IsEnabled="False" Grid.Column="3" Margin="16, 0, 0, 0" HorizontalAlignment="Right" />
            </Grid>

            <local:CpuView x:Name="CpuView" Grid.Row="1" Grid.RowSpan="2" ViewModel="{Binding}" IsVisible="False" />
            <local:LogView x:Name="LogView" Grid.Column="1" Grid.RowSpan="2" Margin="16, 0, 0, 0" IsVisible="False" />

            <local:DetailImageView x:Name="CompiledImage" TitleFontSize="80" AuthorFontSize="36" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="False"/>

            <Grid x:Name="CompletedButtons" Grid.Row="3" Grid.ColumnSpan="2" Margin="0, 16, 0, 0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <!-- 2*, not the WPF source's *: the preflight message is a sentence, and at one
                         ninth of the row it wrapped to five lines and stretched this Auto row to
                         several times the height of the buttons beside it. -->
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="3.5*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2.5*" />
                </Grid.ColumnDefinitions>

                <local:WJButton Width="200" x:Name="OpenLogButton"
                    Text="Open Log"
                    Icon="DocumentText"
                    Grid.Column="0"
                    HorizontalAlignment="Left" />

                <local:WJButton Width="200" x:Name="RefreshPreflightButton"
                    Text="Refresh Checks"
                    Icon="ArrowClockwise"
                    Grid.Column="2"
                    ButtonStyle="Danger"
                    HorizontalAlignment="Left"
                    IsVisible="False"/>

                <!-- Capped at two lines with the full text on hover so an unusually long preflight
                     message cannot drive the row's height on its own. -->
                <TextBlock x:Name="PreflightStatusText"
                   Grid.Column="3"
                   Margin="16,5,0,5"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   MaxLines="2"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding #PreflightStatusText.Text}"
                   HorizontalAlignment="Left"/>

                <local:WJButton x:Name="OpenFolderButton"
                    Text="Open in File Explorer"
                    Icon="Folder"
                    Grid.Column="4"
                    MinWidth="220"
                    HorizontalAlignment="Stretch"
                    ButtonStyle="Color" />

                <local:WJButton x:Name="PublishCollectionButton"
                    MinWidth="320"
                    Text="Publish Nexus Mods Collection (experimental)"
                    Icon="CloudArrowUp"
                    Grid.Column="6"
                    ButtonStyle="Progress" />

                <local:WJButton x:Name="PublishButton"
                    Text="Publish Modlist"
                    Icon="CloudArrowUp"
                    MinWidth="220"
                    Grid.Column="8"
                    HorizontalAlignment="Stretch"
                    ButtonStyle="Progress" />
            </Grid>
        </Grid>

        <!-- MahApps ProgressRing has no Avalonia equivalent control; swapped for an indeterminate
             ProgressBar per PORT_PLAN.md ("MahApps controls -> nearest Avalonia built-in"). -->
        <Grid x:Name="BusyOverlay"
              IsVisible="False"
              Background="#80000000"
              ZIndex="9999">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="420">
                <ProgressBar Width="56" Height="56" IsIndeterminate="True" />
                <TextBlock x:Name="BusyOverlayText"
                           Margin="0,16,0,0"
                           TextAlignment="Center"
                           FontSize="16"
                           Foreground="White"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</rxui:ReactiveUserControl>
