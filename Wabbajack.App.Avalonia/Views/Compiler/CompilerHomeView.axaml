<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:vm="using:Wabbajack.App.Avalonia.ViewModels.Compiler"
                          xmlns:v="using:Wabbajack.App.Avalonia.Views.Compiler"
                          xmlns:c="using:Wabbajack.App.Avalonia.Controls"
                          x:Class="Wabbajack.App.Avalonia.Views.Compiler.CompilerHomeView"
                          x:TypeArguments="vm:CompilerHomeVM"
                          x:DataType="vm:CompilerHomeVM">
    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,*">
            <c:BigButton Title="Compile a new list"
                         Description="Import the modlist.txt file to set up a new Wabbajack modlist export"
                         Icon="Add" Margin="0,0,16,16"
                         AutomationProperties.AutomationId="NewModlistButton" AutomationProperties.Name="Compile a new list"
                         Command="{Binding NewModlistCommand}" />
            <c:BigButton Grid.Column="1" Title="Load compiler settings"
                         Description="Continue the export of an existing modlist or push an update"
                         Icon="ArrowImport" Margin="0,0,0,16"
                         AutomationProperties.AutomationId="LoadSettingsButton" AutomationProperties.Name="Load compiler settings"
                         Command="{Binding LoadSettingsCommand}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,16" ColumnDefinitions="*,6*,*">
            <Border Grid.Column="1" Height="4" CornerRadius="4" Margin="0,10" Background="{StaticResource DarkSecondaryBrush}" />
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <!-- WPF set LineHeight="24" here, but WPF never makes a line shorter than its text, so at 28px
                 it had no effect. Avalonia would honour it, so it is left out. -->
            <TextBlock FontSize="28" VerticalAlignment="Top" HorizontalAlignment="Center"
                       FontWeight="Bold" Margin="0,0,0,32" Text="Recently Compiled Modlists" />

            <ScrollViewer Grid.Row="1" Background="Transparent" VerticalScrollBarVisibility="Auto">
                <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding CompiledModLists}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CompiledModListTileVM">
                            <v:CompiledModListTileView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</rxui:ReactiveUserControl>
