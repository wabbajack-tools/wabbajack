<UserControl
    x:Class="Wabbajack.CompilationCompleteView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icon="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:local="clr-namespace:Wabbajack"
    xmlns:vm="clr-namespace:Wabbajack"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:CompilerDetailsVM"
    mc:Ignorable="d">
    <!-- TODO: local:AttentionBorder is a custom control (Views/Common/AttentionBorder.cs) with a WPF
         DependencyProperty "Failure" and an animated ControlTemplate/Style defined in Themes/CustomControls.xaml
         (MultiDataTrigger + ColorAnimation border glow). It needs its own separate Avalonia port
         (AvaloniaProperty StyledProperty<bool> Failure + Avalonia Style/Animation using :pointerover
         pseudo-class and a Failure-bound class) before this view will function identically. Left the
         reference to local:AttentionBorder in place unchanged per faithful-port conventions. -->
    <local:AttentionBorder x:Name="AttentionBorder" ClipToBounds="True">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                x:Name="TitleText"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontFamily="{StaticResource PrimaryFont}"
                FontSize="22"
                FontWeight="Black">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="25" OffsetX="0" OffsetY="0" Opacity="0.5" />
                </TextBlock.Effect>
            </TextBlock>
            <Grid Grid.Row="1" Grid.Column="0"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0"
                    x:Name="BackButton"
                    Width="55"
                    Height="55"
                    Classes="CircleButtonStyle">
                    <!-- TODO: original icon used icon:PackIconMaterial (MahApps.Metro.IconPacks, Material
                         icon set) which has no listed Avalonia equivalent in the porting conventions
                         (FluentIcons only covers FluentIcons.Wpf -> FluentIcons.Avalonia). Left commented
                         out exactly as in the WPF source, with RelativeSource translated to Avalonia $parent
                         syntax in case this is revisited:
                    <icon:PackIconMaterial
                        Width="28"
                        Height="28"
                        Foreground="{Binding $parent[Button].Foreground}"
                        Kind="ArrowLeft" /> -->
                </Button>
                <TextBlock Grid.Row="1"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Text="Main Menu" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button
                    x:Name="GoToModlistButton"
                    Width="55"
                    Height="55"
                    Classes="CircleButtonStyle">
                    <!-- TODO: see BackButton TODO above regarding icon:PackIconMaterial.
                    <icon:PackIconMaterial
                        Width="25"
                        Height="25"
                        Foreground="{Binding $parent[Button].Foreground}"
                        Kind="FolderMove" /> -->
                </Button>
                <TextBlock Grid.Row="1"
                    x:Name="ActionText"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Text="Output Folder"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="2"
                VerticalAlignment="Center"
                Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!--<Button
                                Width="55"
                                Height="55"
                                Background="{StaticResource PrimaryVariantBrush}"
                                BorderBrush="{StaticResource PrimaryVariantBrush}"
                                IsHitTestVisible="False"
                                Classes="CircleButtonStyle">
                                <Button.Effect>
                                    <BlurEffect Radius="35" />
                                </Button.Effect>
                            </Button>
                            <Button
                                Width="55"
                                Height="55"
                                Background="{StaticResource SecondaryBrush}"
                                BorderBrush="{StaticResource SecondaryBrush}"
                                IsHitTestVisible="False"
                                Classes="CircleButtonStyle">
                                <Button.Effect>
                                    <BlurEffect Radius="15" />
                                </Button.Effect>
                            </Button>-->
                <Button
                    x:Name="CloseWhenCompletedButton"
                    Width="55"
                    Height="55"
                    Classes="CircleButtonStyle">
                    <!-- TODO: see BackButton TODO above regarding icon:PackIconMaterial.
                    <icon:PackIconMaterial
                        Width="30"
                        Height="30"
                        Foreground="{Binding $parent[Button].Foreground}"
                        Kind="Check" /> -->
                </Button>
                <TextBlock Grid.Row="1"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Text="Close" />
            </Grid>
        </Grid>
    </local:AttentionBorder>
</UserControl>
