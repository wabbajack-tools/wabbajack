<rxui:ReactiveUserControl
    x:Class="Wabbajack.CompilerDetailsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Wabbajack"
    xmlns:vm="using:Wabbajack"
    xmlns:rxui="using:Avalonia.ReactiveUI"
    xmlns:fluent="using:FluentIcons.Avalonia"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="vm:CompilerDetailsVM"
    x:DataType="vm:CompilerDetailsVM"
    d:DataContext="{d:DesignInstance vm:CompilerDetailsVM}"
    mc:Ignorable="d">
    <!--
        WPF's keyed <Style TargetType="..." BasedOn="MainTextBoxStyle/MainFilePickerStyle/ListBoxItemStyle">
        resources become class selectors here. ControlTheme is the closer structural match, but it
        replaces the control's whole theme (template included) rather than layering on top of it, and
        the WPF base styles it would need to derive from were themselves template rewrites that the
        Fluent theme already covers - so the surviving property setters are carried as classes.
    -->
    <UserControl.Styles>
        <!-- WPF MainTextBoxStyle + the local ValueStyle overrides on top of it. -->
        <Style Selector="TextBox.Value">
            <Setter Property="Background" Value="{DynamicResource TextBoxBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MaxLength" Value="150" />
            <Setter Property="AcceptsTab" Value="False" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- WPF MainFilePickerStyle + the local PickerStyle margin. -->
        <Style Selector="local|FilePicker.PickerStyle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource ComplementaryPrimary08Brush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- WPF ListBoxItemStyle, applied implicitly to every ListBoxItem in the additional-profiles list. -->
        <Style Selector="ListBox.Profiles ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource ComplementaryPrimary08Brush}" />
        </Style>
        <Style Selector="ListBox.Profiles ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MouseOverListItem}" />
        </Style>
        <Style Selector="ListBox.Profiles ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectedListItem}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SelectedListItemForeground}" />
        </Style>
        <Style Selector="ListBox.Profiles ListBoxItem:disabled /template/ ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource DisabledButtonForeground}" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer x:Name="SettingsScrollViewer" Background="Transparent" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.Resources>
                <Thickness x:Key="TitleMargin">0,8,0,8</Thickness>
                <Thickness x:Key="TextPanelMargin">0,0,16,0</Thickness>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="{StaticResource TextPanelMargin}">
                <DockPanel HorizontalAlignment="Stretch">
                    <TextBlock Margin="{StaticResource TitleMargin}" Text="Author" />
                </DockPanel>
                <TextBox x:Name="AuthorNameSetting" Classes="Value" Watermark="Author name(s)..." />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="{StaticResource TextPanelMargin}">
                <TextBlock Margin="{StaticResource TitleMargin}" Text="Version" />
                <TextBox x:Name="VersionSetting" MaxLength="9" Classes="Value" Watermark="1.0.0..." />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="{StaticResource TextPanelMargin}">
                <TextBlock Margin="{StaticResource TitleMargin}" Text="Title" />
                <TextBox x:Name="ModListNameSetting" Classes="Value" Watermark="Modlist name..." />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="{StaticResource TextPanelMargin}">
                <TextBlock Margin="{StaticResource TitleMargin}" Text="Selected MO2 Profile" />
                <!-- TODO: WPF's IsSynchronizedWithCurrentItem="True" has no Avalonia equivalent (no ICollectionView); dropped. -->
                <ComboBox x:Name="ProfileSetting">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Padding="2,8,0,8" Text="{Binding}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="{StaticResource TextPanelMargin}">
                <TextBlock Margin="{StaticResource TitleMargin}" Text="Description" />
                <TextBox x:Name="DescriptionSetting" Height="135" VerticalContentAlignment="Top" Watermark="A comprehensive overhaul of..." AcceptsReturn="True" AcceptsTab="False" MaxLength="999" Classes="Value" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="{StaticResource TextPanelMargin}">
                <TextBlock Margin="{StaticResource TitleMargin}" Text="Image" />
                <local:FilePicker x:Name="ImageFilePicker" Classes="PickerStyle" Icon="DocumentImage" ToolTip.Tip="Path to an image to display for the modlist." Watermark="C:\...\Thumbnail-1600x900.webp" />
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="{StaticResource TextPanelMargin}">
                <TextBlock Margin="{StaticResource TitleMargin}" Text="Downloads folder" />
                <local:FilePicker x:Name="DownloadsPicker" Classes="PickerStyle" Icon="Folder" ToolTip.Tip="Path to the folder where the downloaded archives of your modlist are stored" Watermark="C:\...\downloads" />
            </StackPanel>
            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="{StaticResource TextPanelMargin}">
                <TextBlock Margin="{StaticResource TitleMargin}" Text="Export destination" />
                <local:FilePicker x:Name="OutputFilePicker" Classes="PickerStyle" Icon="Folder" ToolTip.Tip="Path to the file where the list installer will be saved to on completion" Watermark="C:\...\Modlist.wabbajack" />
            </StackPanel>

            <StackPanel Grid.Row="6" Margin="{StaticResource TextPanelMargin}">
                <DockPanel>
                    <!-- NOTE: WPF also set mahapps:TextBoxHelper.Watermark on this TextBlock; that attached property has no
                         rendering effect on a non-editable TextBlock in WPF either, so it is dropped here as dead markup. -->
                    <TextBlock Margin="{StaticResource TitleMargin}" Text="Documentation (Readme)" ToolTip.Tip="Link to the documentation." />
                    <TextBlock Margin="{StaticResource TitleMargin}" Text="Optional" Opacity="0.5" TextAlignment="Right" HorizontalAlignment="Right" />
                </DockPanel>
                <TextBox x:Name="ReadmeSetting" Classes="Value" Watermark="https://www..." />
            </StackPanel>
            <StackPanel Grid.Row="6" Grid.Column="1" Margin="{StaticResource TextPanelMargin}">
                <DockPanel>
                    <TextBlock Margin="{StaticResource TitleMargin}" Text="Website" />
                    <TextBlock Margin="{StaticResource TitleMargin}" Text="Optional" Opacity="0.5" TextAlignment="Right" HorizontalAlignment="Right" />
                </DockPanel>
                <TextBox x:Name="WebsiteSetting" Classes="Value" Watermark="https://www..." />
            </StackPanel>
            <StackPanel Grid.Row="7" Margin="{StaticResource TextPanelMargin}">
                <DockPanel>
                    <TextBlock Margin="{StaticResource TitleMargin}" Text="Community" />
                    <TextBlock Margin="{StaticResource TitleMargin}" Text="Optional" Opacity="0.5" TextAlignment="Right" HorizontalAlignment="Right" />
                </DockPanel>
                <TextBox x:Name="CommunitySetting" Classes="Value" Watermark="https://discord.gg/..." />
            </StackPanel>
            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Vertical" Margin="{StaticResource TextPanelMargin}">
                <DockPanel>
                    <TextBlock Margin="{StaticResource TitleMargin}" Text="Machine URL" ToolTip.Tip="Unique text string for this modlist prefixed with its GitHub repository name." />
                    <TextBlock Margin="{StaticResource TitleMargin}" Text="Optional" Opacity="0.5" TextAlignment="Right" HorizontalAlignment="Right" />
                </DockPanel>
                <TextBox x:Name="MachineUrl" Classes="Value" Watermark="modlistRepository/ModlistName" />
            </StackPanel>
            <StackPanel Grid.Row="8" Margin="{StaticResource TextPanelMargin}">
                <CheckBox
                    x:Name="NSFWSetting"
                    Margin="{StaticResource TitleMargin}"
                    ToolTip.Tip="Select this if your modlist has adult themed content such as SexLab or other mods involving sexual acts. Nude body replacer do not fall under this category, neither do revealing outfits or gore.">
                    <TextBlock Text="Not Safe For Work (NSFW)" FontSize="10" VerticalAlignment="Center" />
                </CheckBox>
            </StackPanel>

            <StackPanel Grid.Row="8" Grid.Column="1" Margin="{StaticResource TextPanelMargin}">
                <CheckBox
                    x:Name="TextureRecompressionSetting"
                    Margin="{StaticResource TitleMargin}"
                    ToolTip.Tip="If this box is ticked, Wabbajack will recompress DDS textures to save on export file size rather than using the default binary patching method.">
                    <TextBlock Text="Enable Texture Recompression" FontSize="10" VerticalAlignment="Center" />
                </CheckBox>
            </StackPanel>

            <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="{StaticResource TextPanelMargin}">
                <CheckBox
                    x:Name="AutoGenerateReportSetting"
                    Margin="{StaticResource TitleMargin}"
                    ToolTip.Tip="If ticked, Wabbajack will generate an HTML report next to the .wabbajack after compilation.">
                    <TextBlock Text="Auto-generate Modlist HTML Report" FontSize="10" VerticalAlignment="Center" />
                </CheckBox>
            </StackPanel>

            <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Margin="{StaticResource TextPanelMargin}" ToolTip.Tip="Wabbajack will include selected profiles as part of the modlist alongside your main selected MO2 profile.">
                <TextBlock Margin="{StaticResource TitleMargin}" Text="Additional profile(s)" />
                <!-- Classes="Profiles" scopes the ListBoxItem styles declared at the top of this
                     file to this list, standing in for WPF's implicit-by-TargetType ListBoxItem
                     style that only applied inside this ListBox's resource scope. -->
                <ListBox SelectionMode="Multiple" x:Name="AdditionalProfilesSetting" Classes="Profiles">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <fluent:SymbolIcon
                                    Grid.Column="0"
                                    FontSize="13"
                                    Symbol="Checkmark"
                                    IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                    Margin="0,0,0,0" />
                                <TextBlock Grid.Column="2" Padding="4,8,0,8" Text="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</rxui:ReactiveUserControl>
