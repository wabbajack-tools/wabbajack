<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:core="using:Wabbajack"
             xmlns:local="using:Wabbajack"
             xmlns:rxui="http://reactiveui.net"
             x:Class="Wabbajack.CompiledModListTileView"
             x:TypeArguments="core:CompiledModListTileVM"
             x:DataType="core:CompiledModListTileVM">
    <Border CornerRadius="10"
            Width="300"
            Margin="8"
            Background="{DynamicResource ComplementaryPrimary08Brush}"
            BorderBrush="{DynamicResource DarkSecondaryBrush}"
            BorderThickness="1"
            IsVisible="{Binding !Deleted}">
        <Grid RowDefinitions="Auto,Auto,Auto" Margin="12">
            <TextBlock Grid.Row="0"
                       Text="{Binding CompilerSettings.ModListName}"
                       FontSize="20"
                       FontWeight="DemiBold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ForegroundBrush}" />

            <TextBlock Grid.Row="1"
                       Text="{Binding CompilerSettings.Source}"
                       FontSize="13"
                       Opacity="0.5"
                       Margin="0,4,0,8"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ForegroundBrush}" />

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <Button Grid.Column="0"
                        Content="Compile"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding CompileModListCommand}" />

                <Button Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource ErrorBrush}"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Margin="8,0,0,0"
                        Command="{Binding DeleteModListCommand}">
                    <ic:SymbolIcon Symbol="DismissCircle"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</rxui:ReactiveUserControl>
