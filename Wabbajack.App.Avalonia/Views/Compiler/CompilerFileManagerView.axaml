<rxui:ReactiveUserControl
    x:Class="Wabbajack.CompilerFileManagerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wabbajack"
    xmlns:vm="using:Wabbajack"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rxui="using:Avalonia.ReactiveUI"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="vm:CompilerFileManagerVM"
    x:DataType="vm:CompilerFileManagerVM"
    mc:Ignorable="d">
    <!--
        TODO (FileTreeViewItem / TreeView item template): the WPF original relies on
        FileTreeViewItem (ViewModels/Compiler/FileTreeItemVM.cs) being a
        System.Windows.Controls.TreeViewItem subclass whose Header is set directly to a
        FileTreeItemVM in code-behind (CompilerFileManagerVM.LoadSource /
        LoadDirectoryContents), with the actual per-item visuals (folder/file icon via
        FluentIcons Symbol, CompilerFileState checkbox/flag UI) supplied entirely by the
        keyed ControlTemplate `<Style TargetType="{x:Type wj:FileTreeViewItem}"
        BasedOn="{StaticResource TreeViewItem}">` in Themes/Styles.xaml (out of scope for
        this view). Avalonia's TreeView expects a HierarchicalDataTemplate over plain data
        items rather than pre-built TreeViewItem containers, and Avalonia has no
        ControlTemplate-based "is item its own container" style hook equivalent to WPF's
        here. Faithfully porting this requires FileTreeViewItem to be rewritten as an
        Avalonia TreeViewItem subclass (or replaced with a HierarchicalDataTemplate bound to
        FileTreeItemVM) and the Styles.xaml TreeViewItem ControlTemplate to be ported to an
        Avalonia ControlTheme/Style — both out of scope for this file. This view itself only
        declares the bare TreeView; ItemsSource is still assigned from code-behind exactly as
        in the WPF original.
    -->
    <!--
        WPF rounded this panel with an OpacityMask whose VisualBrush pointed at a sibling white,
        rounded Border. Avalonia does not render a live sibling visual correctly as a mask source:
        the resulting mask hid the TreeView almost entirely and left two white bands where the mask
        source itself showed through. CornerRadius + ClipToBounds rounds the panel directly.
    -->
    <Border CornerRadius="8" ClipToBounds="True" BorderThickness="0"
            Background="{StaticResource ComplementaryBackgroundBrush}">
        <TreeView x:Name="FileTreeView" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
    </Border>

</rxui:ReactiveUserControl>
