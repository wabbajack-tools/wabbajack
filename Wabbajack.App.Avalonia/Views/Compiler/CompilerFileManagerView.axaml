<rxui:ReactiveUserControl
    x:Class="Wabbajack.CompilerFileManagerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wabbajack"
    xmlns:vm="using:Wabbajack"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rxui="using:Avalonia.ReactiveUI"
    xmlns:fluent="using:FluentIcons.Avalonia"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="vm:CompilerFileManagerVM"
    x:DataType="vm:CompilerFileManagerVM"
    mc:Ignorable="d">
    <!--
        FileTreeViewItem is an Avalonia TreeViewItem subclass whose Header is set to a
        FileTreeItemVM in code-behind, so the items are their own containers and only the header
        needs a template. WPF supplied those visuals through a keyed FileTreeViewItem
        ControlTemplate in Themes/Styles.xaml; without an equivalent here every row measured to
        nothing and the tree looked empty even with a valid source folder.

        The DataTemplate below is scoped to this TreeView so it wins over the application-level
        ViewLocator, which would otherwise try to resolve a "FileTreeItemView" that does not exist.
        It covers the icon and name; the CompilerFileState flag UI from the WPF template is still
        outstanding.
    -->
    <!--
        WPF rounded this panel with an OpacityMask whose VisualBrush pointed at a sibling white,
        rounded Border. Avalonia does not render a live sibling visual correctly as a mask source:
        the resulting mask hid the TreeView almost entirely and left two white bands where the mask
        source itself showed through. CornerRadius + ClipToBounds rounds the panel directly.
    -->
    <Border CornerRadius="8" ClipToBounds="True" BorderThickness="0"
            Background="{StaticResource ComplementaryBackgroundBrush}">
        <TreeView x:Name="FileTreeView" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.DataTemplates>
                <DataTemplate DataType="vm:FileTreeItemVM">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <fluent:SymbolIcon Grid.Column="0" Symbol="{Binding Symbol}" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Info.Name}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <!-- The compiler flags an entry carries (No Match Include / Include / Ignore /
                             Always Enabled). WPF surfaced these through a MultiSelectComboBox per row;
                             shown here as read-only chips so the tagging is at least visible - editing
                             them still needs a bindable SelectedItems on MultiSelectComboBox. -->
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding CompilerFileStates}"
                                      VerticalAlignment="Center" Margin="8,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ComplementaryPrimary16Brush}"
                                            CornerRadius="4" Padding="6,1">
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </TreeView.DataTemplates>
        </TreeView>
    </Border>

</rxui:ReactiveUserControl>
