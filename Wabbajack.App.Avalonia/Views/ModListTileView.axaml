<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:core="using:Wabbajack"
             xmlns:rxui="http://reactiveui.net"
             x:Class="Wabbajack.ModListTileView"
             x:TypeArguments="core:BaseModListMetadataVM"
             x:DataType="core:BaseModListMetadataVM">
    <rxui:ReactiveUserControl.Styles>
        <!-- Keep the tile button chrome transparent (no Fluent hover fill behind the image). -->
        <Style Selector="Button#TileButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button#TileButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button#TileButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </rxui:ReactiveUserControl.Styles>
    <Button x:Name="TileButton" Command="{Binding DetailsCommand}"
            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <!-- 16:9 card; matches WPF's 476-wide tile (height = width * 9/16). -->
        <Border Margin="8,0,8,16" CornerRadius="8" ClipToBounds="True"
                Width="476" Height="267"
                BoxShadow="0 3 25 0 #40000000"
                Background="{DynamicResource DarkSecondaryBrush}">
            <Grid>
                <!-- Cover image (full bleed) -->
                <Image Source="{Binding Image}" Stretch="UniformToFill" />

                <!-- Loading placeholder -->
                <Border Background="{DynamicResource ComplementaryPrimary08Brush}"
                        IsVisible="{Binding LoadingImage}">
                    <TextBlock Text="Loading..." HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14" Foreground="{DynamicResource ForegroundBrush}" />
                </Border>

                <!-- Bottom gradient + metadata, shown only when the image does NOT already contain the title. -->
                <Grid IsVisible="{Binding !ImageContainsTitle}">
                    <Border VerticalAlignment="Bottom" Height="130">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#D9000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="14,0,14,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Title -->
                        <TextBlock Grid.Row="1" VerticalAlignment="Bottom"
                                   FontWeight="Bold" FontSize="24" TextWrapping="Wrap"
                                   MaxWidth="400" Margin="0,0,0,2"
                                   Text="{Binding Metadata.Title}"
                                   Foreground="{DynamicResource ForegroundBrush}" />
                        <!-- Author -->
                        <TextBlock Grid.Row="2" VerticalAlignment="Bottom" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="by" Foreground="{DynamicResource Transparent66ForegroundBrush}" />
                            <Run Text="{Binding Metadata.Author}" />
                        </TextBlock>
                        <!-- Download / install sizes, bottom-right -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Right">
                            <ic:SymbolIcon Symbol="ArrowDownload" IconVariant="Filled" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,4,0"
                                           Foreground="{DynamicResource Transparent66ForegroundBrush}" />
                            <TextBlock VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"
                                       Foreground="{DynamicResource Transparent66ForegroundBrush}"
                                       Text="{Binding Metadata.DownloadMetadata.SizeOfArchives, Converter={StaticResource FileSize}}" />
                            <ic:SymbolIcon Symbol="Games" IconVariant="Filled" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,4,0"
                                           Foreground="{DynamicResource Transparent66ForegroundBrush}" />
                            <TextBlock VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource Transparent66ForegroundBrush}"
                                       Text="{Binding Metadata.DownloadMetadata.SizeOfInstalledFiles, Converter={StaticResource FileSize}}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Top-left: NSFW / Unavailable status badges (always visible) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="8" Spacing="6">
                    <Border Background="{DynamicResource NSFWBrush}" CornerRadius="4" Padding="6,2"
                            IsVisible="{Binding Metadata.NSFW}">
                        <TextBlock Text="NSFW" FontSize="12" Foreground="{DynamicResource ForegroundBrush}" />
                    </Border>
                    <Border Background="{DynamicResource UnavailableBrush}" CornerRadius="4" Padding="6,2"
                            IsVisible="{Binding IsBroken}">
                        <TextBlock Text="Unavailable" FontSize="12" Foreground="{DynamicResource ForegroundBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Button>
</rxui:ReactiveUserControl>
