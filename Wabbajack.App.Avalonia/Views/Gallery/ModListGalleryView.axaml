<rxui:ReactiveUserControl xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:vm="using:Wabbajack.App.Avalonia.ViewModels.Gallery"
                          xmlns:v="using:Wabbajack.App.Avalonia.Views.Gallery"
                          xmlns:c="using:Wabbajack.App.Avalonia.Controls"
                          xmlns:ic="using:FluentIcons.Avalonia"
                          x:Class="Wabbajack.App.Avalonia.Views.Gallery.ModListGalleryView"
                          x:TypeArguments="vm:ModListGalleryVM"
                          x:DataType="vm:ModListGalleryVM">
    <Grid ColumnDefinitions="270,*">
        <!-- Filters -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- Left-aligned in WPF, where the combo box sized itself to its widest game name and so filled the
                 column anyway; Avalonia sizes a combo box to its selection, so this stretches to the same width. -->
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
                <Grid>
                    <TextBox x:Name="SearchBox" Watermark="Search for a modlist..." Text="{Binding Search}"
                             AutomationProperties.AutomationId="SearchBox" />
                    <Border Width="30" CornerRadius="8" HorizontalAlignment="Right"
                            Background="{StaticResource ComplementaryPrimary08Brush}">
                        <ic:SymbolIcon Symbol="Search" IconVariant="Filled" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource PrimaryBrush}" />
                    </Border>
                </Grid>

                <ComboBox Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center"
                          ItemsSource="{Binding GameTypeEntries}" SelectedItem="{Binding SelectedGameTypeEntry}"
                          ToolTip.Tip="Filter modlists on game" AutomationProperties.AutomationId="GameFilter">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModListGalleryVM+GameTypeEntry">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                                <Border Width="24" Height="24" CornerRadius="4" VerticalAlignment="Center" ClipToBounds="True">
                                    <Image Stretch="Fill" Source="{Binding GameIcon}" />
                                </Border>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding FormattedName}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Row="2" Margin="0,12,0,12" Orientation="Vertical">
                    <!-- A WPF Label: 5px of padding round its text, which the app's 13px TextBlock style reached. -->
                    <TextBlock Margin="5,5,5,9" FontSize="13" Text="Include" />
                    <Border CornerRadius="8" Background="{StaticResource ComplementaryPrimary08Brush}" Padding="0,12,0,12">
                        <StackPanel Orientation="Vertical">
                            <CheckBox Margin="12,0,0,12" VerticalAlignment="Center" Background="{StaticResource BackgroundBrush}"
                                      IsChecked="{Binding IncludeUnofficial}" AutomationProperties.AutomationId="IncludeUnofficial"
                                      ToolTip.Tip="Show modlists that have not been tested to provide a stable experience with official support channels. More info about featured modlists is available on the Wabbajack wiki.">
                                <TextBlock FontSize="10" Text="Non-featured" />
                            </CheckBox>
                            <CheckBox Margin="12,0,0,0" VerticalAlignment="Center" Background="{StaticResource BackgroundBrush}"
                                      IsChecked="{Binding IncludeNSFW}" AutomationProperties.AutomationId="IncludeNSFW"
                                      ToolTip.Tip="Show modlists that include NSFW frameworks.">
                                <TextBlock FontSize="10" Text="NSFW" />
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,12,0,0" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.ColumnSpan="2" FontSize="13" Text="Total Modlist Size" />
                    <c:RangeSlider x:Name="SizeSliderFilter" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                   MinRangeWidth="3" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="1" />
                    <TextBlock x:Name="SizeMinText" Grid.Row="2" Grid.Column="0" Margin="0,4,0,0"
                               Foreground="{StaticResource ComplementaryWhite25Brush}" />
                    <TextBlock x:Name="SizeMaxText" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Margin="0,4,0,0"
                               Foreground="{StaticResource ComplementaryWhite25Brush}" />
                </Grid>

                <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0,24,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Has mod(s)" VerticalAlignment="Center" />
                        <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ExcludeMods}"
                                  ToolTip.Tip="Exclude modlists containing the selected mods instead of including them">
                            <TextBlock FontSize="10" Text="Exclude" />
                        </CheckBox>
                    </Grid>
                    <c:MultiSelectComboBox x:Name="HasModsFilter" Margin="0,12,0,0" IsEditable="True"
                                           Background="{StaticResource ComplementaryPrimary08Brush}" />
                </StackPanel>

                <StackPanel Grid.Row="5" Orientation="Vertical" Margin="0,24,0,0">
                    <TextBlock Text="Has tag(s)" />
                    <c:MultiSelectComboBox x:Name="HasTagsFilter" Margin="0,12,0,0" IsEditable="True"
                                           Background="{StaticResource ComplementaryPrimary08Brush}" />
                </StackPanel>

                <CheckBox Grid.Row="6" Margin="0,24,0,0" VerticalAlignment="Center" IsChecked="{Binding OnlyInstalled}"
                          ToolTip.Tip="Show only modlists for games you have installed on your PC">
                    <TextBlock FontSize="10" VerticalAlignment="Center" Text="Show only modlists for installed games" />
                </CheckBox>

                <c:WJButton Grid.Row="7" Margin="0,24,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Width="NaN" Icon="FilterDismiss" Text="Reset filters"
                            ToolTip.Tip="Reset filters to the default options"
                            AutomationProperties.AutomationId="ResetFiltersButton"
                            Command="{Binding ResetFiltersCommand}" />
            </Grid>
        </ScrollViewer>

        <!-- Tiles. WPF's VirtualizingWrapPanel put a row's spare width at its two ends; a centred wrap panel does the same. -->
        <Border Grid.Column="1" Margin="0,0,0,-16">
            <ScrollViewer x:Name="TileScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          IsEnabled="{Binding !IsResolvingProtocol}">
                <ItemsControl ItemsSource="{Binding ModLists}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GalleryModListMetadataVM">
                            <v:ModListTileView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <c:ProgressRing x:Name="LoadingRing" Grid.Column="1" Width="60" Height="60" Foreground="#CCD8BAF8" IsVisible="False" />

        <StackPanel x:Name="NoneFound" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Orientation="Vertical" IsVisible="False">
            <ic:SymbolIcon Foreground="{StaticResource Triadic2Brush}" HorizontalAlignment="Center" VerticalAlignment="Top"
                           Symbol="DismissCircle" IconVariant="Regular" FontSize="72" />
            <TextBlock FontSize="24" Margin="0,8,0,0" Text="No modlists matching specified criteria" />
        </StackPanel>

        <Grid x:Name="ProtocolOverlay" Grid.ColumnSpan="2" Background="#80000000" ZIndex="9999"
              IsVisible="{Binding IsResolvingProtocol}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <c:ProgressRing Width="56" Height="56" Foreground="#CCD8BAF8" IsActive="True" />
                <TextBlock Margin="0,16,0,0" TextAlignment="Center" FontSize="16" Foreground="White" TextWrapping="Wrap"
                           Text="{Binding ProtocolStatusText}" />
                <TextBlock Margin="0,8,0,0" TextAlignment="Center" FontSize="12" Foreground="#CCFFFFFF"
                           Text="Downloading modlist fileâ€¦" />
            </StackPanel>
        </Grid>
    </Grid>
</rxui:ReactiveUserControl>
