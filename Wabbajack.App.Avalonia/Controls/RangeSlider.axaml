<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Wabbajack">
    <ControlTheme x:Key="{x:Type controls:RangeSlider}" TargetType="controls:RangeSlider">
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid VerticalAlignment="Center">
                    <!-- Inactive track -->
                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                            Background="{DynamicResource ComplementaryPrimary08Brush}" />
                    <!-- Active (selected-range) fill -->
                    <Border Name="PART_ActiveTrack" Height="4" CornerRadius="2"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            Background="{DynamicResource PrimaryBrush}" />
                    <!-- Thumbs positioned absolutely over the track -->
                    <Canvas Name="PART_Track" Height="18" VerticalAlignment="Center" ClipToBounds="False">
                        <Thumb Name="PART_LowerThumb" Width="10" Height="18" Canvas.Top="0">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="3" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                        <Thumb Name="PART_UpperThumb" Width="10" Height="18" Canvas.Top="0">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="3" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Canvas>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
