<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Wabbajack"
    xmlns:mahapps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf">

    <!--
        Clicking anywhere on a band header folds it open or shut, so the header is a button with no chrome
        of its own; everything it shows is drawn by the template below.
    -->
    <Style x:Key="ArchiveGroupHeaderButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The summary row for one band. Deeper than an archive row, the emphasis the page already uses for a
        nested panel, so the list reads as three sections rather than one run of rows.
    -->
    <DataTemplate x:Key="ArchiveGroupHeaderTemplate" DataType="{x:Type local:ArchiveGroupVM}">
        <Button
            Style="{StaticResource ArchiveGroupHeaderButton}"
            Command="{Binding ToggleCommand}"
            AutomationProperties.AutomationId="{Binding Title, Mode=OneTime}">
            <Grid Height="32" Background="{StaticResource ComplementaryPrimary16Brush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ic:SymbolIcon
                    Grid.Column="0"
                    FontSize="14"
                    Width="14"
                    Height="14"
                    IconVariant="Regular"
                    Foreground="{StaticResource Transparent66ForegroundBrush}"
                    Margin="13, 0, 0, 0"
                    VerticalAlignment="Center">
                    <ic:SymbolIcon.Style>
                        <Style TargetType="ic:SymbolIcon">
                            <Setter Property="Symbol" Value="ChevronRight" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="Symbol" Value="ChevronDown" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ic:SymbolIcon.Style>
                </ic:SymbolIcon>

                <TextBlock
                    Grid.Column="1"
                    Text="{Binding Title, Mode=OneTime}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Margin="10, 0, 8, 0"
                    VerticalAlignment="Center"
                    TextWrapping="NoWrap" />

                <TextBlock
                    Grid.Column="2"
                    Text="{Binding SummaryText}"
                    FontSize="12"
                    Foreground="{StaticResource Transparent66ForegroundBrush}"
                    Margin="0, 0, 12, 0"
                    TextAlignment="Right"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>
        </Button>
    </DataTemplate>

    <!--
        One template for every archive row. Rows are virtualized and recycled, so state is expressed with
        DataTriggers rather than a ReactiveUserControl per row; the identity columns bind OneTime.
    -->
    <DataTemplate x:Key="ArchiveRowTemplate" DataType="{x:Type local:ArchiveRowVM}">
        <Grid Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <mahapps:MetroProgressBar
                Grid.ColumnSpan="4"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{StaticResource ComplementaryPrimary16Brush}"
                Maximum="1"
                Value="{Binding Progress, Mode=OneWay}">
                <mahapps:MetroProgressBar.Style>
                    <Style TargetType="mahapps:MetroProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Downloading">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="ManualInProgress">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </mahapps:MetroProgressBar.Style>
            </mahapps:MetroProgressBar>

            <ic:SymbolIcon
                Grid.Column="0"
                FontSize="16"
                Width="16"
                Height="16"
                IconVariant="Filled"
                Margin="12, 0, 0, 0"
                VerticalAlignment="Center">
                <ic:SymbolIcon.Style>
                    <Style TargetType="ic:SymbolIcon">
                        <Setter Property="Symbol" Value="Circle" />
                        <Setter Property="Foreground" Value="{StaticResource ComplementaryWhite25Brush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Present">
                                <Setter Property="Symbol" Value="CheckmarkCircle" />
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Downloaded">
                                <Setter Property="Symbol" Value="CheckmarkCircle" />
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Downloading">
                                <Setter Property="Symbol" Value="ArrowDownload" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="ManualInProgress">
                                <Setter Property="Symbol" Value="ArrowSync" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="ManualRequired">
                                <Setter Property="Symbol" Value="Open" />
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                <Setter Property="Symbol" Value="ErrorCircle" />
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Unsupported">
                                <Setter Property="Symbol" Value="ErrorCircle" />
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ic:SymbolIcon.Style>
            </ic:SymbolIcon>

            <TextBlock
                Grid.Column="1"
                Text="{Binding Name, Mode=OneTime}"
                FontSize="13"
                Margin="10, 0, 8, 0"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                ToolTip="{Binding Detail}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Detail}" Value="">
                                <Setter Property="ToolTipService.IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border
                Grid.Column="2"
                CornerRadius="4"
                Background="{StaticResource ComplementaryPrimary16Brush}"
                Padding="6, 2"
                Margin="0, 0, 8, 0"
                VerticalAlignment="Center">
                <TextBlock
                    Text="{Binding SourceName, Mode=OneTime}"
                    FontSize="11"
                    Foreground="{StaticResource Transparent66ForegroundBrush}"
                    TextWrapping="NoWrap" />
            </Border>

            <TextBlock
                Grid.Column="3"
                Text="{Binding SizeText, Mode=OneTime}"
                FontSize="12"
                MinWidth="64"
                TextAlignment="Right"
                Foreground="{StaticResource ComplementaryWhite25Brush}"
                Margin="0, 0, 12, 0"
                VerticalAlignment="Center"
                TextWrapping="NoWrap" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
