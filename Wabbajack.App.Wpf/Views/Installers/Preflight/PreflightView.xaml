<rxui:ReactiveUserControl
    x:Class="Wabbajack.PreflightView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wabbajack"
    xmlns:mahapps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rxui="http://reactiveui.net"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    x:TypeArguments="local:PreflightVM"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Thickness x:Key="LinkMargin" Bottom="8" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.35*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:DetailImageView x:Name="DetailImage" TitleFontSize="36" AuthorFontSize="16" Margin="0, 0, 0, 16" Height="{Binding ActualWidth, ElementName=DetailImage, Converter={StaticResource MathConverter}, ConverterParameter=x/(16/9)}" />

            <Border Grid.Row="1" Background="{StaticResource ComplementaryPrimary08Brush}" CornerRadius="8" Padding="16, 12, 16, 14" Margin="0, 0, 0, 16">
                <StackPanel>
                    <TextBlock x:Name="SummaryText" FontSize="14" />
                    <mahapps:MetroProgressBar x:Name="SummaryProgress" Height="4" Margin="0, 10, 0, 0" BorderThickness="0" Background="{StaticResource ComplementaryPrimary16Brush}" Foreground="{StaticResource PrimaryBrush}" Maximum="1" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <local:WJButton x:Name="DocumentationButton" Text="Readme" Icon="Document" Grid.Row="0" Margin="{StaticResource LinkMargin}" Width="Auto" />
                <local:WJButton x:Name="WebsiteButton" Text="Website" Icon="Globe" Grid.Row="1" Margin="{StaticResource LinkMargin}" Width="Auto" />
                <local:WJButton x:Name="CommunityButton" Text="Community" Icon="PeopleChat" Grid.Row="2" Margin="{StaticResource LinkMargin}" Width="Auto" />
                <local:WJButton x:Name="ManifestButton" Text="Archives" Icon="BoxSearch" Grid.Row="3" Width="Auto" />
            </Grid>
        </Grid>

        <Grid x:Name="RightColumn" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="PageHeader" Grid.Row="0" Margin="0, 0, 0, 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Preflight" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Checking everything the install needs before it starts" FontSize="13" Foreground="{StaticResource Transparent66ForegroundBrush}" VerticalAlignment="Center" Margin="12, 2, 0, 0" TextTrimming="CharacterEllipsis" />
            </Grid>

            <!--
                The checklist is status, the detail panel is where the user acts, so the checklist is the
                one that scrolls. Its cap is set in code-behind from the column's height so the panel below
                always keeps room for a whole card; the running check is scrolled back into view as it moves.
            -->
            <ScrollViewer x:Name="ChecksScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top">
                <ItemsControl x:Name="ChecksList" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:PreflightCheckRowView Margin="0, 0, 0, 4" ViewModel="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid x:Name="DetailPanel" Grid.Row="2" Margin="0, 8, 0, 16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4, 0, 0, 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ic:SymbolIcon x:Name="DetailIcon" FontSize="16" IconVariant="Regular" Symbol="TaskListSquare" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Current step" FontSize="13" Foreground="{StaticResource Transparent66ForegroundBrush}" VerticalAlignment="Center" Margin="8, 0, 0, 0" />
                        <TextBlock x:Name="DetailSeparator" Text="·" FontSize="13" Foreground="{StaticResource Transparent66ForegroundBrush}" VerticalAlignment="Center" Margin="6, 0, 6, 0" />
                        <TextBlock x:Name="DetailTitle" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <local:WJButton x:Name="ShowAllButton" Grid.Column="1" ButtonStyle="Transparent" Text="Show all" Icon="ChevronDown" IconSize="14" Direction="RightToLeft" Width="130" Height="24" HorizontalAlignment="Right" Margin="8, 0, 0, 0" Visibility="Collapsed" />
                </Grid>

                <Grid Grid.Row="1">
                    <Border x:Name="TextDetail" Background="{StaticResource ComplementaryPrimary08Brush}" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="DetailMessage" FontSize="14" TextWrapping="Wrap" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0, 8, 0, 0">
                                <TextBlock x:Name="DetailText" FontSize="12" Foreground="{StaticResource Transparent66ForegroundBrush}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <local:BulkDownloadsView x:Name="BulkView" Visibility="Collapsed" />
                    <local:ManualDownloadView x:Name="ManualView" Visibility="Collapsed" />
                </Grid>
            </Grid>

            <Grid x:Name="PageActions" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:WJButton x:Name="BackButton" Grid.Column="1" ButtonStyle="Mono" Text="Back" Icon="ChevronLeft" Direction="RightToLeft" HorizontalAlignment="Right" Margin="0, 0, 16, 0" />
                <local:WJButton x:Name="InstallButton" Grid.Column="2" ButtonStyle="Color" Text="Install" Icon="DesktopArrowDown" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Grid>
</rxui:ReactiveUserControl>
