<rxui:ReactiveUserControl
    x:Class="Wabbajack.GameFilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wabbajack"
    xmlns:mahapps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rxui="http://reactiveui.net"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    d:DesignHeight="290"
    d:DesignWidth="700"
    x:TypeArguments="local:GameFilesVM"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ArchiveRowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        Top-aligned inside a scroller, like the manual download card: the panel guarantees the card its
        height, and anything shorter than the supported window scrolls rather than clipping the row of
        buttons off the bottom.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <local:AttentionBorder x:Name="Card" ClipToBounds="True" VerticalAlignment="Top">
            <Grid Margin="16, 10, 16, 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SummaryText" Grid.Column="1" FontSize="12" Foreground="{StaticResource ComplementaryWhite25Brush}" VerticalAlignment="Center" Margin="12, 0, 0, 0" />
                </Grid>

                <TextBlock x:Name="MessageText" Grid.Row="1" FontSize="13" TextWrapping="Wrap" Margin="0, 6, 0, 0" />

                <Border x:Name="ListBorder" Grid.Row="2" CornerRadius="8" BorderThickness="0" Background="White" Margin="0, 10, 0, 0">
                    <Grid Margin="-1">
                        <Border x:Name="ListMask" CornerRadius="8" Background="White" Margin="1" />
                        <Grid>
                            <Grid.OpacityMask>
                                <VisualBrush Visual="{Binding ElementName=ListMask}"/>
                            </Grid.OpacityMask>
                            <!--
                                Band headers, with the rows of a band the user has opened. The card is a
                                fixed-height panel inside a scroller, so this is capped and scrolls: a
                                band opened on a list that takes forty files from the game must not push
                                the buttons off the bottom.
                            -->
                            <ListBox
                                x:Name="RowsList"
                                MaxHeight="160"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                AlternationCount="2"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.CanContentScroll="True"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling"
                                VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemTemplateSelector>
                                    <local:ArchiveListTemplateSelector
                                        RowTemplate="{StaticResource ArchiveRowTemplate}"
                                        GroupTemplate="{StaticResource ArchiveGroupHeaderTemplate}" />
                                </ListBox.ItemTemplateSelector>
                                <ListBox.Resources>
                                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource ListBoxItemStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Style.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                <Setter Property="Background" Value="{StaticResource ComplementaryPrimary08Brush}"/>
                                            </Trigger>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                <Setter Property="Background" Value="{StaticResource LogViewAlternateBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Resources>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock x:Name="ExplainText" Grid.Row="3" FontSize="12" Foreground="{StaticResource Transparent66ForegroundBrush}" TextWrapping="Wrap" Margin="0, 10, 0, 0" />

                <!--
                    The one thing a repair does outside the downloads folder, when it does it: taking a free
                    licence for a tool puts it in the user's Steam library. Said in the offer, in the
                    warning colour, so it is read before the button rather than found afterwards.
                -->
                <Grid x:Name="ConsequenceRow" Grid.Row="4" Margin="0, 8, 0, 0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ic:SymbolIcon FontSize="16" IconVariant="Filled" Symbol="Warning" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="1, 1, 0, 0" />
                    <TextBlock x:Name="ConsequenceText" Grid.Column="1" FontSize="12" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="11, 0, 0, 0" VerticalAlignment="Center" />
                </Grid>

                <Grid x:Name="StatusRow" Grid.Row="5" Margin="0, 8, 0, 0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0, 1, 0, 0">
                        <mahapps:ProgressRing x:Name="StatusRing" Width="18" Height="18" MinWidth="18" MinHeight="18" Foreground="{StaticResource PrimaryBrush}" IsActive="False" Visibility="Collapsed" />
                        <ic:SymbolIcon x:Name="StatusIcon" FontSize="18" IconVariant="Filled" Symbol="CheckmarkCircle" Foreground="{StaticResource SuccessBrush}" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="13" Margin="10, 0, 0, 0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>

                <Grid Grid.Row="6" Margin="0, 12, 0, 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:WJButton x:Name="CheckAgainButton" Grid.Column="1" ButtonStyle="Mono" Text="I fixed it, check again" Icon="ArrowCounterclockwise" IconSize="16" Width="210" Height="32" Margin="0, 0, 8, 0" />
                    <local:WJButton x:Name="RepairButton" Grid.Column="2" ButtonStyle="Color" Icon="ArrowDownload" IconSize="16" Width="210" Height="32" />
                </Grid>
            </Grid>
        </local:AttentionBorder>
    </ScrollViewer>
</rxui:ReactiveUserControl>
