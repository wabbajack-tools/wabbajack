<rxui:ReactiveUserControl
    x:Class="Wabbajack.BulkDownloadsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wabbajack"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rxui="http://reactiveui.net"
    d:DesignHeight="300"
    d:DesignWidth="500"
    x:TypeArguments="local:BulkDownloadsVM"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ArchiveRowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The list must sit in a star row: an Auto row or an outer ScrollViewer disables virtualization. -->
        <Border x:Name="BorderMask2" CornerRadius="8" BorderThickness="0" Background="White">
            <Grid Margin="-1">
                <Border x:Name="BorderMask" CornerRadius="8" Background="White" Margin="1" />
                <Grid>
                    <Grid.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=BorderMask}"/>
                    </Grid.OpacityMask>
                    <ListBox
                        x:Name="RowsList"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        AlternationCount="2"
                        ItemTemplate="{StaticResource ArchiveRowTemplate}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.CanContentScroll="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource ListBoxItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter Property="Background" Value="{StaticResource ComplementaryPrimary08Brush}"/>
                                    </Trigger>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="{StaticResource LogViewAlternateBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0, 8, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText" FontSize="12" Foreground="{StaticResource Transparent66ForegroundBrush}" VerticalAlignment="Center" Margin="4, 0, 0, 0" TextTrimming="CharacterEllipsis" />
            <local:WJButton x:Name="StopButton" Grid.Column="1" ButtonStyle="Mono" Text="Stop downloads" Icon="Stop" IconVariant="Filled" IconSize="14" Width="160" Height="28" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</rxui:ReactiveUserControl>
