<rxui:ReactiveUserControl
    x:Class="Wabbajack.PreflightCheckRowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wabbajack"
    xmlns:mahapps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rxui="http://reactiveui.net"
    xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    d:DesignHeight="40"
    d:DesignWidth="500"
    x:TypeArguments="local:PreflightCheckVM"
    mc:Ignorable="d">
    <Border x:Name="BorderMask2" CornerRadius="8" BorderThickness="0" Background="White">
        <Grid Margin="-1">
            <Border x:Name="BorderMask" CornerRadius="8" Background="White" Margin="1" />
            <Grid x:Name="RowGrid" Height="40" Background="{StaticResource ComplementaryPrimary08Brush}">
                <Grid.OpacityMask>
                    <VisualBrush Visual="{Binding ElementName=BorderMask}"/>
                </Grid.OpacityMask>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <mahapps:MetroProgressBar Grid.ColumnSpan="5" x:Name="BackgroundProgressBar" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ComplementaryPrimary16Brush}" Maximum="1" />
                <Rectangle x:Name="ActiveRule" Grid.Column="0" Width="2" Fill="{StaticResource PrimaryBrush}" Visibility="Hidden" />
                <Grid Grid.Column="1" Width="18" Height="18" Margin="12, 0, 0, 0" VerticalAlignment="Center">
                    <ic:SymbolIcon x:Name="StateIcon" FontSize="18" IconVariant="Filled" Symbol="Circle" Foreground="{StaticResource ComplementaryWhite25Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <mahapps:ProgressRing x:Name="RunningRing" Width="18" Height="18" MinWidth="18" MinHeight="18" Foreground="{StaticResource PrimaryBrush}" IsActive="False" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="TitleText" Grid.Column="2" FontSize="13" Margin="12, 0, 0, 0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                <TextBlock x:Name="StatusText" Grid.Column="3" FontSize="13" Foreground="{StaticResource Transparent66ForegroundBrush}" Margin="16, 0, 12, 0" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <local:WJButton x:Name="ActionButton" Grid.Column="4" ButtonStyle="Mono" Width="150" Height="28" IconSize="14" Icon="ArrowCounterclockwise" Margin="0, 0, 6, 0" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</rxui:ReactiveUserControl>
