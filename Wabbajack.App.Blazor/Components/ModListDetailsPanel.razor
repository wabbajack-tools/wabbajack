@implements IDisposable

@* Floating modlist-details overlay. Bound to the persistent ModListDetailsVM (MetadataVM is populated
   by LoadModlistForDetails before this is shown). Activating the VM loads the archive list. *@
@if (Vm.MetadataVM is { } meta)
{
    <div class="details">
        <img class="details-img" src="@ImageUris.GetLargeImageUri(meta.Metadata)" alt="@meta.Metadata.Title" />
        <div class="details-title">@meta.Metadata.Title</div>
        <div class="details-author">by @meta.Metadata.Author</div>

        @if (meta.ModListTagList is { Count: > 0 } tags)
        {
            <div class="details-tags">
                @foreach (var tag in tags)
                {
                    <span class="tag">@tag.Name</span>
                }
            </div>
        }

        <div class="details-desc">@meta.Metadata.Description</div>

        <div class="details-archives">
            <div class="details-archives-head">Archives@(Vm.Archives is { } a ? $" ({a.Count})" : "")</div>
            @if (Vm.Archives is { Count: > 0 } archives)
            {
                <div class="archive-list">
                    @foreach (var archive in archives)
                    {
                        <div class="archive-row">
                            <span class="archive-name">@archive.Name</span>
                            <span class="archive-size">@ImageUris.FormatBytes(archive.Size)</span>
                        </div>
                    }
                </div>
            }
        </div>

        @if (meta.Status == BaseModListMetadataVM.ModListStatus.Downloading)
        {
            <div class="install-progress">
                <div class="install-progress-bar" style="width:@($"{meta.ProgressPercent.Value * 100:0}%")"></div>
            </div>
        }

        <div class="details-actions">
            @if (meta.Status == BaseModListMetadataVM.ModListStatus.Downloading)
            {
                <button class="btn primary" disabled>Downloading… @($"{meta.ProgressPercent.Value * 100:0}%")</button>
            }
            else
            {
                <button class="btn primary" @onclick="() => Exec(meta.InstallCommand)">Install</button>
            }
            <button class="btn" @onclick="() => Exec(Vm.OpenWebsiteCommand)">Website</button>
            <button class="btn" @onclick="() => Exec(Vm.OpenDiscordCommand)">Discord</button>
            <button class="btn" @onclick="() => Exec(Vm.OpenReadmeCommand)">Readme</button>
            <button class="btn" @onclick="Close">Close</button>
        </div>
    </div>
}

@code {
    [Parameter] public ModListDetailsVM Vm { get; set; } = default!;

    private IDisposable? _activation;
    private IDisposable? _statusSub;
    private System.Collections.Specialized.INotifyCollectionChanged? _archivesHook;

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if (!firstRender) return;

        _activation = Vm.Activator.Activate();
        if (Vm.Archives is System.Collections.Specialized.INotifyCollectionChanged cc)
        {
            _archivesHook = cc;
            cc.CollectionChanged += OnArchivesChanged;
        }

        // Re-render while the modlist downloads so the Install button shows live progress.
        if (Vm.MetadataVM is { } meta)
            _statusSub = meta.WhenAnyValue(x => x.Status, x => x.ProgressPercent)
                .Subscribe(_ => InvokeAsync(StateHasChanged));
    }

    private void OnArchivesChanged(object? s, System.Collections.Specialized.NotifyCollectionChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private void Close()
    {
        if (Vm.CloseCommand.CanExecute(null)) Vm.CloseCommand.Execute(null);
    }

    private static void Exec(System.Windows.Input.ICommand? cmd)
    {
        if (cmd != null && cmd.CanExecute(null)) cmd.Execute(null);
    }

    public void Dispose()
    {
        if (_archivesHook != null) _archivesHook.CollectionChanged -= OnArchivesChanged;
        _statusSub?.Dispose();
        _activation?.Dispose();
    }
}
