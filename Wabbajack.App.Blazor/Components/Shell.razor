@inherits ReactiveInjectableComponentBase<NavigationVM>
@inject ModListDetailsVM DetailsVm
@inject FileUploadVM UploadVm
@* Injected to force early creation so it subscribes to LoadInfoScreen before navigation. *@
@inject InfoVM InfoVm
@inject Wabbajack.Blazor.Services.BlazorUserInterventionHandler Interventions

@* App shell: nav sidebar + routed content + floating overlay. Mirrors WPF MainWindow/MainWindowVM. *@
<div class="app">
    <NavSidebar Vm="ViewModel" />

    <div class="app-main">
        @switch (ViewModel!.ActiveScreen)
        {
            case ScreenType.Home:
                <HomePage />
                break;
            case ScreenType.ModListGallery:
                <GalleryPage />
                break;
            case ScreenType.Settings:
                <SettingsPage />
                break;
            case ScreenType.Info:
                <InfoPage />
                break;
            case ScreenType.CompilerHome:
                <CompilerHomePage />
                break;
            case ScreenType.CompilerMain:
                <CompilerMainPage />
                break;
            case ScreenType.Installer:
                <InstallerPage />
                break;
            default:
                <ScreenPlaceholder Screen="ViewModel.ActiveScreen" />
                break;
        }
    </div>

    <InterventionModal Intervention="_intervention" />

    @if (_floating == FloatingScreenType.ModListDetails)
    {
        <div class="overlay-backdrop" @onclick="CloseFloating">
            <div class="overlay-panel" @onclick:stopPropagation="true">
                <ModListDetailsPanel Vm="DetailsVm" />
            </div>
        </div>
    }
    else if (_floating == FloatingScreenType.FileUpload)
    {
        <div class="overlay-backdrop" @onclick="CloseFloating">
            <div class="overlay-panel" @onclick:stopPropagation="true">
                <FileUploadPanel Vm="UploadVm" />
            </div>
        </div>
    }
</div>

@code {
    private FloatingScreenType _floating = FloatingScreenType.None;
    private global::Wabbajack.AUserIntervention? _intervention;
    private IDisposable? _floatingSub;
    private IDisposable? _interventionSub;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // ShowFloatingWindow isn't a VM property, so subscribe to the bus directly and re-render.
        _floatingSub = MessageBus.Current.Listen<ShowFloatingWindow>()
            .Subscribe(m => InvokeAsync(() => { _floating = m.Screen; StateHasChanged(); }));

        // Interventions are raised from background work; marshal to the UI and re-render.
        _interventionSub = Interventions.Current
            .Subscribe(iv => InvokeAsync(() => { _intervention = iv; StateHasChanged(); }));
    }

    private void CloseFloating() => ShowFloatingWindow.Send(FloatingScreenType.None);

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            _floatingSub?.Dispose();
            _interventionSub?.Dispose();
        }
        base.Dispose(disposing);
    }
}
