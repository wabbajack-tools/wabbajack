@* Custom themed title bar for the chromeless Photino window (mirrors WPF's ShowTitleBar="False").
   Photino's WebView2 doesn't honor -webkit-app-region: drag, so we drag manually: track pointer
   movement over the drag region and reposition the native window by the screen-coordinate delta.
   The window-control buttons are outside the drag region so they don't start a drag. *@
@inject Wabbajack.Blazor.Services.PhotinoWindowHolder Win

<div class="titlebar">
    <div class="titlebar-drag"
         @onpointerdown="StartDrag"
         @onpointermove="OnMove"
         @onpointerup="EndDrag"
         @onpointerup:preventDefault="false"
         @ondblclick="MaxRestore">
        <span class="titlebar-title">Wabbajack</span>
    </div>
    <div class="titlebar-controls">
        <button class="win-btn" title="Minimize" @onclick="Minimize">&#x2012;</button>
        <button class="win-btn" title="Maximize" @onclick="MaxRestore">&#x25A1;</button>
        <button class="win-btn close" title="Close" @onclick="Close">&#x2715;</button>
    </div>
</div>

@code {
    private bool _dragging;
    private double _startScreenX, _startScreenY;
    private int _startLeft, _startTop;

    private void StartDrag(PointerEventArgs e)
    {
        var w = Win.Window;
        if (w is null) return;
        // Dragging a maximized window: restore it first so it tracks the cursor.
        if (w.Maximized) w.SetMaximized(false);
        _dragging = true;
        _startScreenX = e.ScreenX;
        _startScreenY = e.ScreenY;
        _startLeft = w.Left;
        _startTop = w.Top;
    }

    private void OnMove(PointerEventArgs e)
    {
        if (!_dragging) return;
        var w = Win.Window;
        if (w is null) return;
        w.SetLeft(_startLeft + (int)(e.ScreenX - _startScreenX));
        w.SetTop(_startTop + (int)(e.ScreenY - _startScreenY));
    }

    private void EndDrag(PointerEventArgs e) => _dragging = false;

    private void Minimize() => Win.Window?.SetMinimized(true);

    private void MaxRestore()
    {
        var w = Win.Window;
        if (w != null) w.SetMaximized(!w.Maximized);
    }

    private void Close() => Win.Window?.Close();
}
